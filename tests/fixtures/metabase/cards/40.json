    "stages": [
      {
        "lib/type": "mbql.stage/native",
        "native": "SELECT p.paper_type, SUM(o.post_discount_revenue) AS revenue\nFROM orders o JOIN products p ON p.id = o.product_id\nWHERE o.status = 'COMPLETED'\nGROUP BY p.paper_type\nORDER BY revenue DESC"
      }
    ]
  },
