        "lib/type": "mbql.stage/native",
        "native": "SELECT o.status, COUNT(*) AS orders\nFROM orders o JOIN shippings s ON s.order_id = o.id\nWHERE s.region = {{region}}\n[[AND o.purchased_at >= {{since}}]]\nGROUP BY o.status\nORDER BY o.status",
