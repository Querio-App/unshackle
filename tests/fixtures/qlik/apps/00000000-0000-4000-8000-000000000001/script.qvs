///$tab Main
SET ThousandSep=',';
SET DecimalSep='.';
SET DateFormat='YYYY-MM-DD';
SET TimestampFormat='YYYY-MM-DD hh:mm:ss[.fff]';
SET vCompletedStatus = 'COMPLETED';

///$tab Access
Section Access;
LOAD * INLINE [
ACCESS, USERID, PAPER_TYPE, OMIT
ADMIN, DM\DAVID, *,
USER, DM\PAM, COPY,
USER, DM\PAM, PRINTER,
USER, DM\STANLEY, MULTIPURPOSE, order_contact_email
USER, DM\STANLEY, KRAFT ROLL, order_contact_email
USER, DM\OSCAR, CARDSTOCK,
];
Section Application;

///$tab Tables
accounts:
LOAD account_id, account_name, business_size, payment_cycle, account_manager
FROM [lib://Sales:DataFiles/accounts.parquet] (parquet);

// PAPER_TYPE is the Section Access reduction field: upper case, as Section Access requires.
products:
LOAD *, Upper(paper_type) AS PAPER_TYPE
FROM [lib://Sales:DataFiles/products.parquet] (parquet);

orders:
LOAD * FROM [lib://Sales:DataFiles/orders.parquet] (parquet);

shippings:
LOAD
    shipping_id,
    shipping_address,
    shipping_city,
    shipping_state,
    shipping_zip,
    shipping_region,
    shipping_latitude,
    shipping_longitude,
    shipping_mode,
    shipping_cost,
    days_to_ship
FROM [lib://Sales:DataFiles/shippings.parquet] (parquet);

reviews:
LOAD review_id, order_id, review, reviewed_at, rating,
    If(rating >= 4, 'Positive', 'Negative') AS sentiment
FROM [lib://Sales:DataFiles/reviews.parquet] (parquet);

///$tab Targets
// A target per month: what was sold that month plus 10%.
monthly_targets:
LOAD MonthStart(purchased_at) AS target_month, Sum(post_discount_revenue) * 1.1 AS revenue_target
RESIDENT orders
GROUP BY MonthStart(purchased_at);
