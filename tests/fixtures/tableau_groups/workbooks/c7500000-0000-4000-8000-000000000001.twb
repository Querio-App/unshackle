<?xml version='1.0' encoding='utf-8' ?>
<!-- Groups, bins and sets on the Dunder Mifflin tables (tests/test_tableau_groups.py). -->
<workbook locale='en_US' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource caption='Parameters' hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <column caption='Bin Size' datatype='integer' name='[Bin Size]' param-domain-type='range' role='measure' type='quantitative' value='10'>
        <calculation class='tableau' formula='10' />
      </column>
      <column caption='Top N' datatype='integer' name='[Top N]' param-domain-type='range' role='measure' type='quantitative' value='5'>
        <calculation class='tableau' formula='5' />
      </column>
    </datasource>
    <datasource caption='Dunder Mifflin Groups' inline='true' name='federated.grp0demo' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse' name='postgres.grp'>
            <connection class='postgres' dbname='dunder_mifflin' server='warehouse.example.com' />
          </named-connection>
        </named-connections>
        <relation join='inner' type='join'>
          <clause type='join'><expression op='='><expression op='[orders].[product_id]' /><expression op='[products].[product_id]' /></expression></clause>
          <relation join='inner' type='join'>
            <clause type='join'><expression op='='><expression op='[orders].[account_id]' /><expression op='[accounts].[account_id]' /></expression></clause>
            <relation connection='postgres.grp' name='orders' table='[public].[orders]' type='table' />
            <relation connection='postgres.grp' name='accounts' table='[public].[accounts]' type='table' />
          </relation>
          <relation connection='postgres.grp' name='products' table='[public].[products]' type='table' />
        </relation>
        <cols>
      <map key='[order_id]' value='[orders].[order_id]' />
      <map key='[status]' value='[orders].[status]' />
      <map key='[post_discount_revenue]' value='[orders].[post_discount_revenue]' />
      <map key='[discount_percentage]' value='[orders].[discount_percentage]' />
      <map key='[days_to_close]' value='[orders].[days_to_close]' />
      <map key='[account_id]' value='[orders].[account_id]' />
      <map key='[product_id]' value='[orders].[product_id]' />
      <map key='[account_id (accounts)]' value='[accounts].[account_id]' />
      <map key='[account_name]' value='[accounts].[account_name]' />
      <map key='[account_manager]' value='[accounts].[account_manager]' />
      <map key='[payment_cycle]' value='[accounts].[payment_cycle]' />
      <map key='[product_id (products)]' value='[products].[product_id]' />
      <map key='[paper_type]' value='[products].[paper_type]' />
        </cols>
        <metadata-records>
      <metadata-record class='column'><remote-name>order_id</remote-name><local-name>[order_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>status</remote-name><local-name>[status]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>post_discount_revenue</remote-name><local-name>[post_discount_revenue]</local-name><parent-name>[orders]</parent-name><local-type>real</local-type></metadata-record>
      <metadata-record class='column'><remote-name>discount_percentage</remote-name><local-name>[discount_percentage]</local-name><parent-name>[orders]</parent-name><local-type>real</local-type></metadata-record>
      <metadata-record class='column'><remote-name>days_to_close</remote-name><local-name>[days_to_close]</local-name><parent-name>[orders]</parent-name><local-type>integer</local-type></metadata-record>
      <metadata-record class='column'><remote-name>account_id</remote-name><local-name>[account_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>product_id</remote-name><local-name>[product_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>account_id</remote-name><local-name>[account_id (accounts)]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>account_name</remote-name><local-name>[account_name]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>account_manager</remote-name><local-name>[account_manager]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>payment_cycle</remote-name><local-name>[payment_cycle]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>product_id</remote-name><local-name>[product_id (products)]</local-name><parent-name>[products]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>paper_type</remote-name><local-name>[paper_type]</local-name><parent-name>[products]</parent-name><local-type>string</local-type></metadata-record>
        </metadata-records>
      </connection>
    <column datatype='string' name='[order_id]' role='dimension' type='nominal' />
    <column datatype='string' name='[status]' role='dimension' type='nominal' />
    <column datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' />
    <column datatype='real' name='[discount_percentage]' role='measure' type='quantitative' />
    <column datatype='integer' name='[days_to_close]' role='measure' type='quantitative' />
    <column datatype='string' name='[account_id]' role='dimension' type='nominal' />
    <column datatype='string' name='[product_id]' role='dimension' type='nominal' />
    <column datatype='string' name='[account_id (accounts)]' role='dimension' type='nominal' />
    <column datatype='string' name='[account_name]' role='dimension' type='nominal' />
    <column datatype='string' name='[account_manager]' role='dimension' type='nominal' />
    <column datatype='string' name='[payment_cycle]' role='dimension' type='nominal' />
    <column datatype='string' name='[product_id (products)]' role='dimension' type='nominal' />
    <column datatype='string' name='[paper_type]' role='dimension' type='nominal' />
    <column caption="Discount Cycle" datatype='string' name='[Calculation_201]' role='dimension' type='nominal'>
      <calculation class='tableau' formula="IF [discount_percentage] &gt; 0 THEN [payment_cycle] END" />
    </column>
    <column caption="Returned Revenue" datatype='real' name='[Calculation_202]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [status] = "RETURNED" THEN [post_discount_revenue] END' />
    </column>
    <column caption="Days Shifted" datatype='integer' name='[Calculation_203]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="[days_to_close] - 30" />
    </column>
    <column caption="Paper Other" datatype='string' name='[Paper Other]' role='dimension' type='nominal'>
      <calculation class='categorical-bin' column='[paper_type]' default='"Other"' new-bin='true'><bin default-name='false' value='"Office"'><value>"Copy"</value><value>"Printer"</value></bin></calculation>
    </column>
    <column caption="Paper Keep" datatype='string' name='[Paper Keep]' role='dimension' type='nominal'>
      <calculation class='categorical-bin' column='[paper_type]' new-bin='true'><bin default-name='false' value='"Office"'><value>"Copy"</value><value>"Printer"</value></bin></calculation>
    </column>
    <column caption="Cycle Other" datatype='string' name='[Cycle Other]' role='dimension' type='nominal'>
      <calculation class='categorical-bin' column='[Calculation_201]' default='"Other"' new-bin='true'><bin default-name='false' value='"Frequent"'><value>"WEEK"</value><value>"BIWEEK"</value></bin></calculation>
    </column>
    <column caption="Cycle Keep" datatype='string' name='[Cycle Keep]' role='dimension' type='nominal'>
      <calculation class='categorical-bin' column='[Calculation_201]' new-bin='true'><bin default-name='false' value='"Frequent"'><value>"WEEK"</value><value>"BIWEEK"</value></bin></calculation>
    </column>
    <column caption="Cycle Null" datatype='string' name='[Cycle Null]' role='dimension' type='nominal'>
      <calculation class='categorical-bin' column='[Calculation_201]' new-bin='true'><bin default-name='false' value='"Unknown"'><value>%null%</value><value>""</value></bin></calculation>
    </column>
    <column caption="Days Bin" datatype='integer' name='[Days Bin]' role='dimension' type='ordinal'>
      <calculation class='bin' decimals='0' formula='[days_to_close]' peg='0' size="10" />
    </column>
    <column caption="Days Shifted Bin" datatype='integer' name='[Days Shifted Bin]' role='dimension' type='ordinal'>
      <calculation class='bin' decimals='0' formula='[Calculation_203]' peg='0' size="7" />
    </column>
    <column caption="Returned Bin" datatype='integer' name='[Returned Bin]' role='dimension' type='ordinal'>
      <calculation class='bin' decimals='0' formula='[Calculation_202]' peg='0' size="100000" />
    </column>
    <column caption="Discount Bin" datatype='real' name='[Discount Bin]' role='dimension' type='ordinal'>
      <calculation class='bin' decimals='0' formula='[discount_percentage]' peg='0' size="0.05" />
    </column>
    <column caption="Days Peg Bin" datatype='integer' name='[Days Peg Bin]' role='dimension' type='ordinal'>
      <calculation class='bin' decimals='0' formula='[days_to_close]' peg='5' size="10" />
    </column>
    <column caption="Days Param Bin" datatype='integer' name='[Days Param Bin]' role='dimension' type='ordinal'>
      <calculation class='bin' decimals='0' formula='[days_to_close]' peg='0' size="[Parameters].[Bin Size]" />
    </column>
    <group caption="Managers Fixed" name='[Managers Fixed]' name-style='unqualified' user:ui-builder='identity-set'><groupfilter function='union'><groupfilter function='member' level='[account_manager]' member='"Dwight Schrute"' /><groupfilter function='member' level='[account_manager]' member='"Creed Patton"' /><groupfilter function='member' level='[account_manager]' member='"Pam Beesly"' /></groupfilter></group>
    <group caption="Managers Except" name='[Managers Except]' name-style='unqualified' user:ui-builder='identity-set'><groupfilter function='except' user:ui-enumeration='exclusive'><groupfilter function='level-members' level='[account_manager]' /><groupfilter function='member' level='[account_manager]' member='"Dwight Schrute"' /></groupfilter></group>
    <group caption="Cycle Set" name='[Cycle Set]' name-style='unqualified' user:ui-builder='identity-set'><groupfilter function='union'><groupfilter function='member' level='[Calculation_201]' member="%null%" /><groupfilter function='member' level='[Calculation_201]' member='"WEEK"' /></groupfilter></group>
    <group caption="Big Accounts" name='[Big Accounts]' name-style='unqualified' user:ui-builder='filter-group'><groupfilter expression="SUM([post_discount_revenue]) &gt; 2000000" function='filter' user:ui-filter-by-field='true' user:ui-marker='filter-by'><groupfilter function='level-members' level='[account_name]' user:ui-enumeration='all' user:ui-marker='enumerate' /></groupfilter></group>
    <group caption="Busy Accounts" name='[Busy Accounts]' name-style='unqualified' user:ui-builder='filter-group'><groupfilter expression="SUM([post_discount_revenue]) &gt; 1500000 AND COUNTD([order_id]) &gt; 20" function='filter' user:ui-filter-by-field='true' user:ui-marker='filter-by'><groupfilter function='level-members' level='[account_name]' user:ui-enumeration='all' user:ui-marker='enumerate' /></groupfilter></group>
    <group caption="Low Returned" name='[Low Returned]' name-style='unqualified' user:ui-builder='filter-group'><groupfilter expression="SUM([Calculation_202]) &lt; 1000000" function='filter' user:ui-filter-by-field='true' user:ui-marker='filter-by'><groupfilter function='level-members' level='[account_name]' user:ui-enumeration='all' user:ui-marker='enumerate' /></groupfilter></group>
    <group caption="Top Managers" name='[Top Managers]' name-style='unqualified' user:ui-builder='filter-group'><groupfilter count="4" end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'><groupfilter direction='DESC' expression="COUNTD([account_id])" function='order' user:ui-marker='order'><groupfilter function='level-members' level='[account_manager]' user:ui-enumeration='all' user:ui-marker='enumerate' /></groupfilter></groupfilter></group>
    <group caption="Bottom Managers" name='[Bottom Managers]' name-style='unqualified' user:ui-builder='filter-group'><groupfilter count="3" end='bottom' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'><groupfilter direction='DESC' expression="COUNTD([account_id])" function='order' user:ui-marker='order'><groupfilter function='level-members' level='[account_manager]' user:ui-enumeration='all' user:ui-marker='enumerate' /></groupfilter></groupfilter></group>
    <group caption="Top Returned" name='[Top Returned]' name-style='unqualified' user:ui-builder='filter-group'><groupfilter count="120" end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'><groupfilter direction='DESC' expression="SUM([Calculation_202])" function='order' user:ui-marker='order'><groupfilter function='level-members' level='[account_name]' user:ui-enumeration='all' user:ui-marker='enumerate' /></groupfilter></groupfilter></group>
    <group caption="Bottom Returned" name='[Bottom Returned]' name-style='unqualified' user:ui-builder='filter-group'><groupfilter count="10" end='bottom' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'><groupfilter direction='DESC' expression="SUM([Calculation_202])" function='order' user:ui-marker='order'><groupfilter function='level-members' level='[account_name]' user:ui-enumeration='all' user:ui-marker='enumerate' /></groupfilter></groupfilter></group>
    <group caption="Asc Top Revenue" name='[Asc Top Revenue]' name-style='unqualified' user:ui-builder='filter-group'><groupfilter count="3" end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'><groupfilter direction='ASC' expression="SUM([post_discount_revenue])" function='order' user:ui-marker='order'><groupfilter function='level-members' level='[account_manager]' user:ui-enumeration='all' user:ui-marker='enumerate' /></groupfilter></groupfilter></group>
    <group caption="Top Cycles" name='[Top Cycles]' name-style='unqualified' user:ui-builder='filter-group'><groupfilter count="2" end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'><groupfilter direction='DESC' expression="COUNTD([order_id])" function='order' user:ui-marker='order'><groupfilter function='level-members' level='[Calculation_201]' user:ui-enumeration='all' user:ui-marker='enumerate' /></groupfilter></groupfilter></group>
    <group caption="Param Top" name='[Param Top]' name-style='unqualified' user:ui-builder='filter-group'><groupfilter count="[Parameters].[Top N]" end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'><groupfilter direction='DESC' expression="SUM([post_discount_revenue])" function='order' user:ui-marker='order'><groupfilter function='level-members' level='[account_name]' user:ui-enumeration='all' user:ui-marker='enumerate' /></groupfilter></groupfilter></group>
    <group caption="Pairs" name='[Pairs]' name-style='unqualified' user:ui-builder='identity-set'><groupfilter function='union'><groupfilter function='member' level='[account_manager]' member='&quot;Pam Beesly&quot;' /><groupfilter function='member' level='[paper_type]' member='&quot;Copy&quot;' /></groupfilter></group>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="G Paper Other">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Groups' name='federated.grp0demo' /></datasources>
          
        </view>
        <panes><pane><mark class='Text' /><encodings><text column='[federated.grp0demo].[sum:post_discount_revenue:qk]' /><text column='[federated.grp0demo].[ctd:order_id:qk]' /></encodings></pane></panes>
        <rows>[federated.grp0demo].[Paper Other]</rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="G Paper Keep">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Groups' name='federated.grp0demo' /></datasources>
          
