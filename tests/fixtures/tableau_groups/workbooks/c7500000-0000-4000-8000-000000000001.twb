        <view>
          <datasources><datasource caption='Dunder Mifflin Groups' name='federated.grp0demo' /></datasources>
          
        </view>
        <panes><pane><mark class='Text' /><encodings><text column='[federated.grp0demo].[sum:post_discount_revenue:qk]' /></encodings></pane></panes>
        <rows>[federated.grp0demo].[none:account_manager:nk] / [federated.grp0demo].[io:Managers Except:nk]</rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="SD Managers Except">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Groups' name='federated.grp0demo' /></datasources>
          
        </view>
        <panes><pane><mark class='Text' /><encodings><text column='[federated.grp0demo].[sum:post_discount_revenue:qk]' /></encodings></pane></panes>
        <rows>[federated.grp0demo].[Managers Except]</rows>
        <cols></cols>
