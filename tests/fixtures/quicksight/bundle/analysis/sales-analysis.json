    "calculatedFields": [
      {
        "dataSetIdentifier": "orders",
        "name": "Revenue",
        "expression": "sum({post_discount_revenue})"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Order count",
        "expression": "count({order_id})"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Completed revenue",
        "expression": "sumIf({post_discount_revenue}, {status} = 'COMPLETED')"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Completed orders",
        "expression": "countIf({order_id}, {status} = 'COMPLETED')"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Unique accounts",
        "expression": "distinct_count({account_id})"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Average order value",
        "expression": "sum({post_discount_revenue}) / count({order_id})"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Discount rate",
        "expression": "1 - sum({post_discount_revenue}) / sum({pre_discount_revenue})"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Days to cancel",
        "expression": "dateDiff({purchased_at}, {cancelled_at}, 'DD')"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Purchase year",
        "expression": "extract('YYYY', {purchased_at})"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Big order flag",
        "expression": "ifelse({quantity} >= 100 AND {status} = 'COMPLETED', 'Big completed', isNull({cancelled_at}), 'Open', 'Other')"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Account revenue",
        "expression": "sum({post_discount_revenue}, [{account_id}])"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Account revenue window",
        "expression": "sumOver({post_discount_revenue}, [{account_id}], PRE_AGG)"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Running revenue",
        "expression": "runningSum(sum({post_discount_revenue}), [truncDate('MM', {purchased_at}) ASC])"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Share of revenue",
        "expression": "percentOfTotal(sum({post_discount_revenue}))"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Revenue MoM",
        "expression": "periodOverPeriodPercentDifference(sum({post_discount_revenue}), {purchased_at}, MONTH, 1)"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Revenue rank",
        "expression": "rank([sum({post_discount_revenue}) DESC])"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Visual share",
        "expression": "sum({post_discount_revenue}) / sumOver(sum({post_discount_revenue}), [$visualDimensions])"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Orders before filters",
        "expression": "countOver({order_id}, [{status}], PRE_FILTER)"
      },
      {
        "dataSetIdentifier": "orders",
        "name": "Matches status parameter",
        "expression": "ifelse({status} = ${StatusParam}, 1, 0)"
      }
    ],
    "parameterDeclarations": [
      {
        "stringParameterDeclaration": {
          "parameterValueType": "SINGLE_VALUED",
          "name": "StatusParam",
          "defaultValues": {
            "staticValues": []
          },
          "valueWhenUnset": {
            "valueWhenUnsetOption": "NULL"
          }
        }
      }
    ],
    "filterGroups": [
