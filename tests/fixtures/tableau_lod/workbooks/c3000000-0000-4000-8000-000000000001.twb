<?xml version='1.0' encoding='utf-8' ?>
<workbook version='18.1'>
  <datasources>
    <datasource caption='Dunder Mifflin LOD' inline='true' name='federated.lod0demo' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse' name='postgres.lod'>
            <connection class='postgres' dbname='dunder_mifflin' server='warehouse.example.com' />
          </named-connection>
        </named-connections>
        <relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[orders].[product_id]' />
              <expression op='[products].[product_id]' />
            </expression>
          </clause>
          <relation join='inner' type='join'>
            <clause type='join'>
              <expression op='='>
                <expression op='[orders].[account_id]' />
                <expression op='[accounts].[account_id]' />
              </expression>
            </clause>
            <relation connection='postgres.lod' name='orders' table='[public].[orders]' type='table' />
            <relation connection='postgres.lod' name='accounts' table='[public].[accounts]' type='table' />
          </relation>
          <relation connection='postgres.lod' name='products' table='[public].[products]' type='table' />
        </relation>
        <cols>
      <map key="[order_id]" value="[orders].[order_id]" />
      <map key="[status]" value="[orders].[status]" />
      <map key="[purchased_at]" value="[orders].[purchased_at]" />
      <map key="[post_discount_revenue]" value="[orders].[post_discount_revenue]" />
      <map key="[account_id]" value="[orders].[account_id]" />
      <map key="[product_id]" value="[orders].[product_id]" />
      <map key="[account_id (accounts)]" value="[accounts].[account_id]" />
      <map key="[account_name]" value="[accounts].[account_name]" />
      <map key="[payment_cycle]" value="[accounts].[payment_cycle]" />
      <map key="[product_id (products)]" value="[products].[product_id]" />
      <map key="[paper_type]" value="[products].[paper_type]" />
        </cols>
        <metadata-records>
      <metadata-record class='column'>
        <remote-name>order_id</remote-name>
        <local-name>[order_id]</local-name>
        <parent-name>[orders]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>status</remote-name>
        <local-name>[status]</local-name>
        <parent-name>[orders]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>purchased_at</remote-name>
        <local-name>[purchased_at]</local-name>
        <parent-name>[orders]</parent-name>
        <local-type>date</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>post_discount_revenue</remote-name>
        <local-name>[post_discount_revenue]</local-name>
        <parent-name>[orders]</parent-name>
        <local-type>real</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>account_id</remote-name>
        <local-name>[account_id]</local-name>
        <parent-name>[orders]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>product_id</remote-name>
        <local-name>[product_id]</local-name>
        <parent-name>[orders]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>account_id</remote-name>
        <local-name>[account_id (accounts)]</local-name>
        <parent-name>[accounts]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>account_name</remote-name>
        <local-name>[account_name]</local-name>
        <parent-name>[accounts]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>payment_cycle</remote-name>
        <local-name>[payment_cycle]</local-name>
        <parent-name>[accounts]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>product_id</remote-name>
        <local-name>[product_id (products)]</local-name>
        <parent-name>[products]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>paper_type</remote-name>
        <local-name>[paper_type]</local-name>
        <parent-name>[products]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
        </metadata-records>
      </connection>
    <column datatype="string" name="[order_id]" role="dimension" type="nominal" />
    <column datatype="string" name="[status]" role="dimension" type="nominal" />
    <column datatype="date" name="[purchased_at]" role="dimension" type="nominal" />
    <column datatype="real" name="[post_discount_revenue]" role="measure" type="quantitative" />
    <column datatype="string" name="[account_id]" role="dimension" type="nominal" />
    <column datatype="string" name="[product_id]" role="dimension" type="nominal" />
    <column datatype="string" name="[account_id (accounts)]" role="dimension" type="nominal" />
    <column datatype="string" name="[account_name]" role="dimension" type="nominal" />
    <column datatype="string" name="[payment_cycle]" role="dimension" type="nominal" />
    <column datatype="string" name="[product_id (products)]" role="dimension" type="nominal" />
    <column datatype="string" name="[paper_type]" role="dimension" type="nominal" />
    <column caption="Account Revenue" datatype="real" name="[Calculation_101]" role="measure" type="quantitative">
      <calculation class='tableau' formula="{FIXED [account_id] : SUM([post_discount_revenue])}" />
    </column>
    <column caption="Account Tier" datatype="string" name="[Calculation_102]" role="dimension" type="nominal">
      <calculation class='tableau' formula='IF [Calculation_101] &gt;= 1000000 THEN "Large" ELSEIF [Calculation_101] &gt;= 250000 THEN "Mid" ELSE "Small" END' />
    </column>
    <column caption="Avg Account Revenue" datatype="real" name="[Calculation_103]" role="measure" type="quantitative">
      <calculation class='tableau' formula="AVG({FIXED [account_id] : SUM([post_discount_revenue])})" />
    </column>
    <column caption="First Order Date" datatype="date" name="[Calculation_104]" role="dimension" type="ordinal">
      <calculation class='tableau' formula="{FIXED [account_name] : MIN([purchased_at])}" />
    </column>
    <column caption="Avg Order Revenue" datatype="real" name="[Calculation_105]" role="measure" type="quantitative">
      <calculation class='tableau' formula="AVG({INCLUDE [order_id] : SUM([post_discount_revenue])})" />
    </column>
    <column caption="Cycle Revenue" datatype="real" name="[Calculation_106]" role="measure" type="quantitative">
      <calculation class='tableau' formula="{EXCLUDE [paper_type] : SUM([post_discount_revenue])}" />
    </column>
    <column caption="Account Paper Revenue" datatype="real" name="[Calculation_107]" role="measure" type="quantitative">
      <calculation class='tableau' formula="{FIXED [account_id], [paper_type] : SUM([post_discount_revenue])}" />
    </column>
    <column caption="Share of Account Revenue" datatype="real" name="[Calculation_108]" role="measure" type="quantitative">
      <calculation class='tableau' formula="[post_discount_revenue] / [Calculation_101]" />
    </column>
    <column caption="Revenue Share" datatype="real" name="[Calculation_109]" role="measure" type="quantitative">
      <calculation class='tableau' formula="SUM([post_discount_revenue]) / SUM([Calculation_101])" />
    </column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Revenue by Account Tier">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin LOD' name='federated.lod0demo' /></datasources>
        </view>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.lod0demo].[none:Calculation_102:nk]</rows>
        <cols>[federated.lod0demo].[sum:post_discount_revenue:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Average Account Revenue">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin LOD' name='federated.lod0demo' /></datasources>
        </view>
        <panes><pane><mark class="Text" /><encodings><text column="[federated.lod0demo].[usr:Calculation_103:qk]" /></encodings></pane></panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="Account Revenue by Payment Cycle">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin LOD' name='federated.lod0demo' /></datasources>
        </view>
        <panes><pane><mark class="Bar" /><encodings><tooltip column="[federated.lod0demo].[sum:post_discount_revenue:qk]" /></encodings></pane></panes>
        <rows>[federated.lod0demo].[none:payment_cycle:nk]</rows>
        <cols>[federated.lod0demo].[avg:Calculation_101:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Order Size by Paper Type">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin LOD' name='federated.lod0demo' /></datasources>
        </view>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.lod0demo].[none:paper_type:nk]</rows>
        <cols>[federated.lod0demo].[usr:Calculation_105:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Cycle Revenue by Paper Type">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin LOD' name='federated.lod0demo' /></datasources>
        </view>
        <panes><pane><mark class="Text" /><encodings><text column="[federated.lod0demo].[sum:Calculation_106:qk]" /><tooltip column="[federated.lod0demo].[sum:post_discount_revenue:qk]" /></encodings></pane></panes>
        <rows>[federated.lod0demo].[none:paper_type:nk] / [federated.lod0demo].[none:payment_cycle:nk]</rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="New Accounts by Month">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin LOD' name='federated.lod0demo' /></datasources>
        </view>
        <panes><pane><mark class="Line" /></pane></panes>
        <rows>[federated.lod0demo].[ctd:account_name:qk]</rows>
        <cols>[federated.lod0demo].[tmn:Calculation_104:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Top Account per Paper Type">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin LOD' name='federated.lod0demo' /></datasources>
        </view>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.lod0demo].[none:paper_type:nk]</rows>
        <cols>[federated.lod0demo].[max:Calculation_107:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Share of Account Revenue by Status">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin LOD' name='federated.lod0demo' /></datasources>
        </view>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.lod0demo].[none:status:nk]</rows>
        <cols>[federated.lod0demo].[sum:Calculation_108:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Revenue Share by Status">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin LOD' name='federated.lod0demo' /></datasources>
        </view>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.lod0demo].[none:status:nk]</rows>
        <cols>[federated.lod0demo].[usr:Calculation_109:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
</workbook>
