model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation PBI_QueryOrder = ["Server","Database","Sales","Customer","Date","Returns","Key Measures"]

	annotation __PBI_TimeIntelligenceEnabled = 0

ref table Sales
ref table Customer
ref table Date
ref table Returns
ref table 'Key Measures'

ref role 'EU Sales'
ref role 'Account Managers'

ref cultureInfo en-US
