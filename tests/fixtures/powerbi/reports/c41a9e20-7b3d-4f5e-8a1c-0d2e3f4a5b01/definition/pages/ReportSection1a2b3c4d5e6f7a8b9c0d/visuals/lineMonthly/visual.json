{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "lineMonthly",
  "position": {
    "x": 640,
    "y": 160,
    "z": 0,
    "height": 360,
    "width": 600,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "HierarchyLevel": {
                  "Expression": {
                    "Hierarchy": {
                      "Expression": {
                        "PropertyVariationSource": {
                          "Expression": {
                            "SourceRef": {
                              "Entity": "Sales"
                            }
                          },
                          "Name": "Variation",
                          "Property": "OrderDate"
                        }
                      },
                      "Hierarchy": "Date Hierarchy"
                    }
                  },
                  "Level": "Month"
                }
              },
              "queryRef": "Sales.OrderDate.Variation.Date Hierarchy.Month",
              "nativeQueryRef": "OrderDate Month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Sales"
                    }
                  },
                  "Property": "Total Sales"
                }
              },
              "queryRef": "Sales.Total Sales",
              "nativeQueryRef": "Total Sales"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Sales"
                    }
                  },
                  "Property": "Channel"
                }
              },
              "queryRef": "Sales.Channel",
              "nativeQueryRef": "Channel"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly sales by channel'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
