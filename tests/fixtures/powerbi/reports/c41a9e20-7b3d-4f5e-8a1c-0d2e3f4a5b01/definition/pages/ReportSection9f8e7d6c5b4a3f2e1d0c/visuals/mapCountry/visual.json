{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "mapCountry",
  "position": {
    "x": 20,
    "y": 420,
    "z": 0,
    "height": 280,
    "width": 600,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "filledMap",
    "query": {
      "queryState": {
        "Location": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Customer"
                    }
                  },
                  "Property": "Country"
                }
              },
              "queryRef": "Customer.Country",
              "nativeQueryRef": "Country"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Sales"
                    }
                  },
                  "Property": "Total Sales"
                }
              },
              "queryRef": "Sales.Total Sales",
              "nativeQueryRef": "Total Sales"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Sales by country'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
