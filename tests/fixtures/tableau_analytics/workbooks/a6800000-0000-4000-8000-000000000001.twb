<workbook version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <column caption='Min Order Value' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='500.0'><calculation class='tableau' formula='500.0' /><range granularity='50.0' max='5000.0' min='0.0' /></column>
    </datasource>
    <datasource caption='Dunder Mifflin Analytics' inline='true' name='federated.analytics0' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse' name='postgres.analytics'>
            <connection class='postgres' dbname='dunder_mifflin' server='warehouse.example.com' />
          </named-connection>
        </named-connections>
        <relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[orders].[product_id]' />
              <expression op='[products].[product_id]' />
            </expression>
          </clause>
          <relation join='inner' type='join'>
            <clause type='join'>
              <expression op='='>
                <expression op='[orders].[account_id]' />
                <expression op='[accounts].[account_id]' />
              </expression>
            </clause>
            <relation connection='postgres.analytics' name='orders' table='[public].[orders]' type='table' />
            <relation connection='postgres.analytics' name='accounts' table='[public].[accounts]' type='table' />
          </relation>
          <relation connection='postgres.analytics' name='products' table='[public].[products]' type='table' />
        </relation>
        <cols>
      <map key="[order_id]" value="[orders].[order_id]" />
      <map key="[status]" value="[orders].[status]" />
      <map key="[purchased_at]" value="[orders].[purchased_at]" />
      <map key="[post_discount_revenue]" value="[orders].[post_discount_revenue]" />
