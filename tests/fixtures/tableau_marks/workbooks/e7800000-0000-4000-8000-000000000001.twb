<?xml version='1.0' encoding='utf-8' ?>
<workbook version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource caption='Dunder Mifflin Marks' inline='true' name='federated.marks0demo' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse' name='postgres.marks'>
            <connection class='postgres' dbname='dunder_mifflin' server='warehouse.example.com' />
          </named-connection>
        </named-connections>
        <relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[orders].[product_id]' />
              <expression op='[products].[product_id]' />
            </expression>
          </clause>
          <relation join='inner' type='join'>
            <clause type='join'>
              <expression op='='>
                <expression op='[orders].[account_id]' />
                <expression op='[accounts].[account_id]' />
              </expression>
            </clause>
            <relation connection='postgres.marks' name='orders' table='[public].[orders]' type='table' />
            <relation connection='postgres.marks' name='accounts' table='[public].[accounts]' type='table' />
          </relation>
          <relation connection='postgres.marks' name='products' table='[public].[products]' type='table' />
        </relation>
        <cols>
          <map key='[order_id]' value='[orders].[order_id]' />
          <map key='[status]' value='[orders].[status]' />
          <map key='[purchased_at]' value='[orders].[purchased_at]' />
          <map key='[quantity]' value='[orders].[quantity]' />
          <map key='[pre_discount_revenue]' value='[orders].[pre_discount_revenue]' />
          <map key='[discount_percentage]' value='[orders].[discount_percentage]' />
          <map key='[post_discount_revenue]' value='[orders].[post_discount_revenue]' />
          <map key='[days_to_close]' value='[orders].[days_to_close]' />
          <map key='[account_id]' value='[orders].[account_id]' />
          <map key='[product_id]' value='[orders].[product_id]' />
          <map key='[account_id (accounts)]' value='[accounts].[account_id]' />
          <map key='[payment_cycle]' value='[accounts].[payment_cycle]' />
          <map key='[product_id (products)]' value='[products].[product_id]' />
          <map key='[paper_type]' value='[products].[paper_type]' />
        </cols>
        <metadata-records>
          <metadata-record class='column'><remote-name>order_id</remote-name><local-name>[order_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>status</remote-name><local-name>[status]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>purchased_at</remote-name><local-name>[purchased_at]</local-name><parent-name>[orders]</parent-name><local-type>date</local-type></metadata-record>
          <metadata-record class='column'><remote-name>quantity</remote-name><local-name>[quantity]</local-name><parent-name>[orders]</parent-name><local-type>integer</local-type></metadata-record>
          <metadata-record class='column'><remote-name>pre_discount_revenue</remote-name><local-name>[pre_discount_revenue]</local-name><parent-name>[orders]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>discount_percentage</remote-name><local-name>[discount_percentage]</local-name><parent-name>[orders]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>post_discount_revenue</remote-name><local-name>[post_discount_revenue]</local-name><parent-name>[orders]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>days_to_close</remote-name><local-name>[days_to_close]</local-name><parent-name>[orders]</parent-name><local-type>integer</local-type></metadata-record>
          <metadata-record class='column'><remote-name>account_id</remote-name><local-name>[account_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>product_id</remote-name><local-name>[product_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>account_id</remote-name><local-name>[account_id (accounts)]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>payment_cycle</remote-name><local-name>[payment_cycle]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>product_id</remote-name><local-name>[product_id (products)]</local-name><parent-name>[products]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>paper_type</remote-name><local-name>[paper_type]</local-name><parent-name>[products]</parent-name><local-type>string</local-type></metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
    <column caption='Revenue' datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' />
    <column aggregation='Avg' datatype='integer' name='[days_to_close]' role='measure' type='quantitative' />
    <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
      <aliases>
        <alias key='"[federated.marks0demo].[sum:pre_discount_revenue:qk]"' value='Gross Revenue' />
        <alias key='"[federated.marks0demo].[sum:post_discount_revenue:qk]"' value='Net Revenue' />
      </aliases>
    </column>
    <column caption="Average Order Value" datatype='real' name='[Calculation_7801]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="SUM([post_discount_revenue]) / COUNTD([order_id])" />
    </column>
    <column caption="Cancelled Quantity" datatype='integer' name='[Calculation_7802]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [status] = "CANCELLED" THEN [quantity] END' />
    </column>
    </datasource>
    <datasource caption='Shipments' inline='true' name='federated.ship0demo' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse' name='postgres.ship'>
            <connection class='postgres' dbname='dunder_mifflin' server='warehouse.example.com' />
          </named-connection>
        </named-connections>
        <relation connection='postgres.ship' name='shippings' table='[public].[shippings]' type='table' />
        <metadata-records>
          <metadata-record class='column'><remote-name>shipping_id</remote-name><local-name>[shipping_id]</local-name><parent-name>[shippings]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>shipping_city</remote-name><local-name>[shipping_city]</local-name><parent-name>[shippings]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>shipping_state</remote-name><local-name>[shipping_state]</local-name><parent-name>[shippings]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>shipping_region</remote-name><local-name>[shipping_region]</local-name><parent-name>[shippings]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>shipping_latitude</remote-name><local-name>[shipping_latitude]</local-name><parent-name>[shippings]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>shipping_longitude</remote-name><local-name>[shipping_longitude]</local-name><parent-name>[shippings]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>shipping_cost</remote-name><local-name>[shipping_cost]</local-name><parent-name>[shippings]</parent-name><local-type>real</local-type></metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
    <column datatype='string' name='[shipping_id]' role='dimension' type='nominal' />
    <column datatype='string' name='[shipping_city]' role='dimension' semantic-role="[City].[Name]" type='nominal' />
    <column datatype='string' name='[shipping_state]' role='dimension' semantic-role="[State].[Name]" type='nominal' />
    <column datatype='string' name='[shipping_region]' role='dimension' type='nominal' />
    <column datatype='real' name='[shipping_latitude]' role='measure' semantic-role="[Geographical].[Latitude]" type='quantitative' />
    <column datatype='real' name='[shipping_longitude]' role='measure' semantic-role="[Geographical].[Longitude]" type='quantitative' />
    <column datatype='real' name='[shipping_cost]' role='measure' type='quantitative' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Measures by Paper Type">
      <table>
        <view>
          <datasources>
            <datasource caption='Dunder Mifflin Marks' name='federated.marks0demo' />
          </datasources>
          <datasource-dependencies datasource='federated.marks0demo'>
            <column datatype='string' name='[paper_type]' role='dimension' type='nominal' />
            <column datatype='integer' name='[quantity]' role='measure' type='quantitative' />
            <column caption='Revenue' datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' />
            <column datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption="Average Order Value" datatype='real' name='[Calculation_7801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([post_discount_revenue]) / COUNTD([order_id])" />
            </column>
            <column-instance column='[paper_type]' derivation='None' name='[none:paper_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[quantity]' derivation='Sum' name='[sum:quantity:qk]' pivot='key' type='quantitative' />
            <column-instance column='[post_discount_revenue]' derivation='Avg' name='[avg:post_discount_revenue:qk]' pivot='key' type='quantitative' />
            <column-instance column='[order_id]' derivation='CountD' name='[ctd:order_id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_7801]' derivation='User' name='[usr:Calculation_7801:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.marks0demo].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='"[federated.marks0demo].[sum:quantity:qk]"' />
              <groupfilter function='member' level='[:Measure Names]' member='"[federated.marks0demo].[avg:post_discount_revenue:qk]"' />
              <groupfilter function='member' level='[:Measure Names]' member='"[federated.marks0demo].[ctd:order_id:qk]"' />
              <groupfilter function='member' level='[:Measure Names]' member='"[federated.marks0demo].[usr:Calculation_7801:qk]"' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.marks0demo].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>"[federated.marks0demo].[ctd:order_id:qk]"</bucket>
              <bucket>"[federated.marks0demo].[sum:quantity:qk]"</bucket>
              <bucket>"[federated.marks0demo].[sum:discount_percentage:qk]"</bucket>
              <bucket>"[federated.marks0demo].[usr:Calculation_7801:qk]"</bucket>
              <bucket>"[federated.marks0demo].[avg:post_discount_revenue:qk]"</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
        <style></style>
        <panes>
          <pane id='0' selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.marks0demo].[:Measure Names]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.marks0demo].[Multiple Values]</rows>
        <cols>[federated.marks0demo].[none:paper_type:nk]</cols>
      </table>
    </worksheet>
