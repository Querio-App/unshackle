            <encoding attr='space' class='0' field='[federated.marks0demo].[ctd:order_id:qk]' field-type='quantitative' fold='true' scope='rows' type='space' />
          </style-rule>
        </style>
        <panes>
          <pane id='0' selection-relaxation-option='selection-relaxation-allow'>
