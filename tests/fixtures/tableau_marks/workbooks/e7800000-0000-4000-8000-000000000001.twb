            </view>
            <mark class='Bar' />
          </pane>
          <pane id='2' selection-relaxation-option='selection-relaxation-allow' y-axis-name='[federated.marks0demo].[ctd:order_id:qk]'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
          </pane>
        </panes>
        <rows>([federated.marks0demo].[sum:post_discount_revenue:qk] + [federated.marks0demo].[ctd:order_id:qk])</rows>
        <cols>[federated.marks0demo].[tmn:purchased_at:qk]</cols>
