        <panes><pane><mark class="Bar" /><encodings><tooltip column='[federated.display0demo].[cnt:post_discount_revenue:qk]' /></encodings></pane></panes>
        <rows>[federated.display0demo].[none:paper_type:nk]</rows>
        <cols>[federated.display0demo].[sum:quantity:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
</workbook>
