<?xml version='1.0' encoding='utf-8' ?>
<workbook version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource caption='Dunder Mifflin Display' inline='true' name='federated.display0demo' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse' name='postgres.display'>
            <connection class='postgres' dbname='dunder_mifflin' server='warehouse.example.com' />
          </named-connection>
        </named-connections>
        <relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[orders].[product_id]' />
              <expression op='[products].[product_id]' />
            </expression>
          </clause>
          <relation join='inner' type='join'>
            <clause type='join'>
              <expression op='='>
                <expression op='[orders].[account_id]' />
                <expression op='[accounts].[account_id]' />
              </expression>
            </clause>
            <relation connection='postgres.display' name='orders' table='[public].[orders]' type='table' />
            <relation connection='postgres.display' name='accounts' table='[public].[accounts]' type='table' />
          </relation>
          <relation connection='postgres.display' name='products' table='[public].[products]' type='table' />
        </relation>
        <cols>
      <map key="[order_id]" value="[orders].[order_id]" />
      <map key="[status]" value="[orders].[status]" />
      <map key="[purchased_at]" value="[orders].[purchased_at]" />
      <map key="[post_discount_revenue]" value="[orders].[post_discount_revenue]" />
      <map key="[quantity]" value="[orders].[quantity]" />
      <map key="[discount_percentage]" value="[orders].[discount_percentage]" />
      <map key="[account_id]" value="[orders].[account_id]" />
      <map key="[product_id]" value="[orders].[product_id]" />
      <map key="[account_id (accounts)]" value="[accounts].[account_id]" />
      <map key="[account_name]" value="[accounts].[account_name]" />
      <map key="[payment_cycle]" value="[accounts].[payment_cycle]" />
      <map key="[product_id (products)]" value="[products].[product_id]" />
      <map key="[paper_type]" value="[products].[paper_type]" />
        </cols>
        <metadata-records>
      <metadata-record class='column'>
        <remote-name>order_id</remote-name>
        <local-name>[order_id]</local-name>
        <parent-name>[orders]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>status</remote-name>
        <local-name>[status]</local-name>
        <parent-name>[orders]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>purchased_at</remote-name>
        <local-name>[purchased_at]</local-name>
        <parent-name>[orders]</parent-name>
        <local-type>date</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>post_discount_revenue</remote-name>
        <local-name>[post_discount_revenue]</local-name>
        <parent-name>[orders]</parent-name>
        <local-type>real</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>account_id</remote-name>
        <local-name>[account_id]</local-name>
        <parent-name>[orders]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>product_id</remote-name>
        <local-name>[product_id]</local-name>
        <parent-name>[orders]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>account_id</remote-name>
        <local-name>[account_id (accounts)]</local-name>
        <parent-name>[accounts]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>account_name</remote-name>
        <local-name>[account_name]</local-name>
        <parent-name>[accounts]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>payment_cycle</remote-name>
        <local-name>[payment_cycle]</local-name>
        <parent-name>[accounts]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>product_id</remote-name>
        <local-name>[product_id (products)]</local-name>
        <parent-name>[products]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>paper_type</remote-name>
        <local-name>[paper_type]</local-name>
        <parent-name>[products]</parent-name>
        <local-type>string</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>quantity</remote-name>
        <local-name>[quantity]</local-name>
        <parent-name>[orders]</parent-name>
        <local-type>integer</local-type>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>discount_percentage</remote-name>
        <local-name>[discount_percentage]</local-name>
        <parent-name>[orders]</parent-name>
        <local-type>real</local-type>
      </metadata-record>
        </metadata-records>
      </connection>
    <column datatype="string" name="[order_id]" role="dimension" type="nominal" />
    <column datatype="string" name="[status]" role="dimension" type="nominal" />
    <column datatype="date" name="[purchased_at]" role="dimension" type="nominal" />
    <column caption="Revenue" datatype="real" default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name="[post_discount_revenue]" role="measure" type="quantitative" />
    <column datatype="integer" default-format='n#,##0;-#,##0' name="[quantity]" role="measure" type="quantitative" />
    <column datatype="real" default-format='c&quot;$&quot;#,##0,K' name="[discount_percentage]" role="measure" type="quantitative" />
    <column datatype="string" name="[account_id]" role="dimension" type="nominal" />
    <column datatype="string" name="[product_id]" role="dimension" type="nominal" />
    <column datatype="string" name="[account_id (accounts)]" role="dimension" type="nominal" />
    <column datatype="string" name="[account_name]" role="dimension" type="nominal" />
    <column datatype="string" name="[payment_cycle]" role="dimension" type="nominal">
      <aliases>
        <alias key='&quot;&quot;' value='(no cycle)' />
      </aliases>
    </column>
    <column datatype="string" name="[product_id (products)]" role="dimension" type="nominal" />
    <column datatype="string" name="[paper_type]" role="dimension" type="nominal">
      <aliases>
        <alias key='&quot;Copy&quot;' value='Copy Paper' />
        <alias key='&quot;Printer&quot;' value='Printer Paper' />
        <alias key='&quot;Cardstock&quot;' value='Zeta Card' />
        <alias key='&quot;Kraft Roll&quot;' value='Multipurpose' />
      </aliases>
    </column>
    <column caption="Open Status" datatype="string" name="[Calculation_201]" role="dimension" type="nominal">
      <calculation class="tableau" formula="IF [status] &lt;&gt; &quot;COMPLETED&quot; THEN [status] END" />
      <aliases>
        <alias key='%null%' value='Still open' />
        <alias key='&quot;RETURNED&quot;' value='Sent back' />
      </aliases>
    </column>
    <column caption="Open Raw" datatype="string" name="[Calculation_202]" role="dimension" type="nominal">
      <calculation class="tableau" formula="IF [status] &lt;&gt; &quot;COMPLETED&quot; THEN [status] END" />
    </column>
    <column caption="Mixed Case" datatype="string" name="[Calculation_203]" role="dimension" type="nominal">
      <calculation class="tableau" formula="IF [status] = &quot;CANCELLED&quot; THEN &quot;cancelled&quot; ELSE [status] END" />
    </column>
    <column caption="Discounted?" datatype="boolean" name="[Calculation_204]" role="dimension" type="nominal">
      <calculation class="tableau" formula="[discount_percentage] &gt; 10" />
      <aliases>
        <alias key='true' value='Discounted' />
      </aliases>
    </column>
    <column caption="Paper Revenue" datatype="real" default-format='p0.0%' name="[Calculation_205]" role="measure" type="quantitative">
      <calculation class="tableau" formula="{FIXED [paper_type] : SUM([post_discount_revenue])}" />
    </column>
    <column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
    <default-sorts>
      <manual-sort column='[none:status:nk]' direction='ASC'>
        <dictionary>
          <bucket>&quot;RETURNED&quot;</bucket>
          <bucket>&quot;COMPLETED&quot;</bucket>
          <bucket>&quot;CANCELLED&quot;</bucket>
        </dictionary>
      </manual-sort>
    </default-sorts>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Aliases">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Display' name='federated.display0demo' /></datasources>
        </view>
        <style></style>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.display0demo].[none:paper_type:nk]</rows>
        <cols>[federated.display0demo].[sum:post_discount_revenue:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Alpha Desc">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Display' name='federated.display0demo' /></datasources>
          <alphabetic-sort column='[federated.display0demo].[none:paper_type:nk]' direction='DESC' />
        </view>
        <style></style>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.display0demo].[none:paper_type:nk]</rows>
        <cols>[federated.display0demo].[sum:post_discount_revenue:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Computed Desc">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Display' name='federated.display0demo' /></datasources>
          <computed-sort column='[federated.display0demo].[none:paper_type:nk]' direction='DESC' using='[federated.display0demo].[sum:post_discount_revenue:qk]' />
        </view>
        <style></style>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.display0demo].[none:paper_type:nk]</rows>
        <cols>[federated.display0demo].[sum:post_discount_revenue:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Computed Hidden">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Display' name='federated.display0demo' /></datasources>
          <computed-sort column='[federated.display0demo].[none:paper_type:nk]' direction='ASC' using='[federated.display0demo].[ctd:order_id:qk]' />
        </view>
        <style></style>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.display0demo].[none:paper_type:nk]</rows>
        <cols>[federated.display0demo].[sum:quantity:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Manual">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Display' name='federated.display0demo' /></datasources>
          <manual-sort column='[federated.display0demo].[none:payment_cycle:nk]' direction='DESC'><dictionary><bucket>&quot;WEEK&quot;</bucket><bucket>&quot;MONTH&quot;</bucket><bucket>&quot;ANNUAL&quot;</bucket><bucket>%all%</bucket></dictionary></manual-sort>
        </view>
        <style></style>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.display0demo].[none:payment_cycle:nk]</rows>
        <cols>[federated.display0demo].[sum:post_discount_revenue:qk]</cols>
      </table>
