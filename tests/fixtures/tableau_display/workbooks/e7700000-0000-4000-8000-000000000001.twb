    <worksheet name="Paper Revenue Share">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Display' name='federated.display0demo' /></datasources>
          <computed-sort column='[federated.display0demo].[none:paper_type:nk]' direction='DESC' using='[federated.display0demo].[avg:Calculation_205:qk]' />
        </view>
        <style></style>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.display0demo].[none:paper_type:nk]</rows>
        <cols>[federated.display0demo].[avg:Calculation_205:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Formats">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Display' name='federated.display0demo' /></datasources>
        </view>
        <style><style-rule element='cell'><format attr='text-format' field='[federated.display0demo].[avg:discount_percentage:qk]' value='p0.0%' /></style-rule></style>
        <panes><pane><mark class="Text" /><encodings><text column='[federated.display0demo].[sum:post_discount_revenue:qk]' /><tooltip column='[federated.display0demo].[avg:discount_percentage:qk]' /></encodings></pane></panes>
        <rows>[federated.display0demo].[none:paper_type:nk]</rows>
        <cols></cols>
      </table>
