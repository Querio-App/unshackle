      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Display' name='federated.display0demo' /></datasources>
          <natural-sort column='[federated.display0demo].[none:paper_type:nk]' direction='DESC' />
        </view>
        <style></style>
