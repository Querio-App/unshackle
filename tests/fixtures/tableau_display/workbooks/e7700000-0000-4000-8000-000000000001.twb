      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Display' name='federated.display0demo' /></datasources>
          <alphabetic-sort column='[federated.display0demo].[none:Calculation_203:nk]' direction='DESC' />
        </view>
        <style></style>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.display0demo].[none:Calculation_203:nk]</rows>
