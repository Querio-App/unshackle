    <worksheet name="Null Raw Natural Desc">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Display' name='federated.display0demo' /></datasources>
          <natural-sort column='[federated.display0demo].[none:Calculation_202:nk]' direction='DESC' />
        </view>
        <style></style>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.display0demo].[none:Calculation_202:nk]</rows>
        <cols>[federated.display0demo].[sum:post_discount_revenue:qk]</cols>
      </table>
