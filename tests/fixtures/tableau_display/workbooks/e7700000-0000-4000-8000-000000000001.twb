        <cols>[federated.display0demo].[sum:post_discount_revenue:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Nested Computed">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Display' name='federated.display0demo' /></datasources>
          <computed-sort column='[federated.display0demo].[none:paper_type:nk]' direction='DESC' using='[federated.display0demo].[sum:post_discount_revenue:qk]' />
        </view>
        <style></style>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.display0demo].[none:payment_cycle:nk] / [federated.display0demo].[none:paper_type:nk]</rows>
        <cols>[federated.display0demo].[sum:post_discount_revenue:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Nested Computed Avg">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Display' name='federated.display0demo' /></datasources>
          <computed-sort column='[federated.display0demo].[none:paper_type:nk]' direction='DESC' using='[federated.display0demo].[avg:post_discount_revenue:qk]' />
        </view>
        <style></style>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.display0demo].[none:payment_cycle:nk] / [federated.display0demo].[none:paper_type:nk]</rows>
        <cols>[federated.display0demo].[avg:post_discount_revenue:qk]</cols>
      </table>
