<?xml version='1.0' encoding='utf-8' ?>
<workbook version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption="Growth Rate" datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value="0.10000000000000001"><calculation class='tableau' formula="0.10000000000000001" /><range granularity='0.01' max='1.0' min='0.0' /></column>
      <column caption="Churn Rate" datatype='real' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value="0.064000000000000001"><calculation class='tableau' formula="0.064000000000000001" /><range granularity='0.001' max='0.25' min='0.0' /></column>
      <column caption="Commission Rate" datatype='real' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value="18.399999999999999"><calculation class='tableau' formula="18.399999999999999" /><range granularity='0.10000000000000001' max='100.0' min='1.0' /></column>
      <column caption="Revenue Target" datatype='integer' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value="1500000"><calculation class='tableau' formula="1500000" /><range granularity='250000' min='250000' /></column>
      <column caption="Measure" datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='"Revenue"'><calculation class='tableau' formula='"Revenue"' /><aliases><alias key='&quot;Orders&quot;' value='Order count' /></aliases><members><member value='&quot;Revenue&quot;' /><member value='&quot;Quantity&quot;' /><member alias='Order count' value='&quot;Orders&quot;' /><member value='&quot;\% Discounted&quot;' /></members></column>
      <column caption="Group By" datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='"Status"'><calculation class='tableau' formula='"Status"' /><members><member value='&quot;Status&quot;' /><member value='&quot;Account&quot;' /></members></column>
      <column caption="Start Date" datatype='date' name='[Parameter 7]' param-domain-type='range' role='measure' type='quantitative' value="#2025-01-01#"><calculation class='tableau' formula="#2025-01-01#" /><range granularity='1' max='#2026-12-31#' min='#2024-01-01#' period-type-v2='month' /></column>
      <column caption="Include Cancelled" datatype='boolean' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value="false"><calculation class='tableau' formula="false" /><members><member value='true' /><member value='false' /></members></column>
      <column caption="Max Days" datatype='integer' name='[Parameter 9]' param-domain-type='list' role='measure' type='quantitative' value="14"><calculation class='tableau' formula="14" /><members><member value='7' /><member value='14' /><member value='30' /></members></column>
    </datasource>
    <datasource caption='Orders' inline='true' name='federated.params0demo' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse' name='postgres.params'>
            <connection class='postgres' dbname='dunder_mifflin' server='warehouse.example.com' author-locale='en_US' />
          </named-connection>
        </named-connections>
        <relation connection='postgres.params' name='orders' table='[public].[orders]' type='table' />
        <metadata-records>
          <metadata-record class='column'><remote-name>post_discount_revenue</remote-name><local-name>[post_discount_revenue]</local-name><parent-name>[orders]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>status</remote-name><local-name>[status]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>account_id</remote-name><local-name>[account_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>order_id</remote-name><local-name>[order_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>quantity</remote-name><local-name>[quantity]</local-name><parent-name>[orders]</parent-name><local-type>integer</local-type></metadata-record>
          <metadata-record class='column'><remote-name>discount_percentage</remote-name><local-name>[discount_percentage]</local-name><parent-name>[orders]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>purchased_at</remote-name><local-name>[purchased_at]</local-name><parent-name>[orders]</parent-name><local-type>date</local-type></metadata-record>
          <metadata-record class='column'><remote-name>cancelled_at</remote-name><local-name>[cancelled_at]</local-name><parent-name>[orders]</parent-name><local-type>date</local-type></metadata-record>
          <metadata-record class='column'><remote-name>days_to_close</remote-name><local-name>[days_to_close]</local-name><parent-name>[orders]</parent-name><local-type>integer</local-type></metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column caption="Forecast Revenue" datatype='real' name='[Calculation_7601]' role='measure' type='quantitative'><calculation class='tableau' formula="[post_discount_revenue] * (1 - [Parameters].[Parameter 2]) * (1 + [Parameters].[Parameter 1])" /></column>
      <column caption="Commission" datatype='real' name='[Calculation_7602]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([post_discount_revenue]) * [Parameters].[Parameter 3] / 100" /></column>
      <column caption="Target Band" datatype='string' name='[Calculation_7603]' role='dimension' type='nominal'><calculation class='tableau' formula='IF SUM([post_discount_revenue]) &gt;= [Parameters].[Parameter 4] THEN "Above target"&#10;ELSEIF SUM([post_discount_revenue]) &gt;= 0.5 * [Parameters].[Parameter 4] THEN "Halfway"&#10;ELSE "Below" END' /></column>
      <column caption="Selected Measure" datatype='real' name='[Calculation_7604]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN "Revenue" THEN SUM([post_discount_revenue])&#10;WHEN "Quantity" THEN SUM([quantity])&#10;WHEN "Orders" THEN COUNTD([order_id])&#10;WHEN "% Discounted" THEN AVG([discount_percentage])&#10;END' /></column>
      <column caption="Breakdown" datatype='string' name='[Calculation_7605]' role='dimension' type='nominal'><calculation class='tableau' formula='CASE [Parameters].[Parameter 6] WHEN "Status" THEN [status] ELSE [account_id] END' /></column>
      <column caption="Since Start" datatype='boolean' name='[Calculation_7606]' role='dimension' type='nominal'><calculation class='tableau' formula="[purchased_at] &gt;= DATETRUNC('week', [Parameters].[Parameter 7])" /></column>
      <column caption="Counted" datatype='boolean' name='[Calculation_7607]' role='dimension' type='nominal'><calculation class='tableau' formula='[Parameters].[Parameter 8] OR [status] &lt;&gt; "CANCELLED"' /></column>
      <column caption="Quick Close" datatype='boolean' name='[Calculation_7608]' role='dimension' type='nominal'><calculation class='tableau' formula="[days_to_close] &lt;= [Parameters].[Parameter 9]" /></column>
      <column caption="Cancelled Since Start" datatype='boolean' name='[Calculation_7610]' role='dimension' type='nominal'><calculation class='tableau' formula="[cancelled_at] &gt;= [Parameters].[Parameter 7]" /></column>
      <column caption="Forecast Uplift" datatype='real' name='[Calculation_7609]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([Calculation_7601]) - SUM([post_discount_revenue])" /></column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="What If Forecast">
      <table>
        <view>
          <datasources><datasource caption='Orders' name='federated.params0demo' /><datasource name='Parameters' /></datasources>
          <datasource-dependencies datasource='Parameters'><column caption="Churn Rate" datatype='real' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value="0.064000000000000001"><calculation class='tableau' formula="0.064000000000000001" /><range granularity='0.001' max='0.25' min='0.0' /></column><column caption="Growth Rate" datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value="0.10000000000000001"><calculation class='tableau' formula="0.10000000000000001" /><range granularity='0.01' max='1.0' min='0.0' /></column></datasource-dependencies>
          <datasource-dependencies datasource='federated.params0demo'><column datatype='string' name='[status]' role='dimension' type='nominal' /><column caption="Forecast Revenue" datatype='real' name='[Calculation_7601]' role='measure' type='quantitative'><calculation class='tableau' formula="[post_discount_revenue] * (1 - [Parameters].[Parameter 2]) * (1 + [Parameters].[Parameter 1])" /></column><column caption="Revenue" datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[Calculation_7601]' derivation='Sum' name='[sum:Calculation_7601:qk]' pivot='key' type='quantitative' /><column-instance column='[post_discount_revenue]' derivation='Sum' name='[sum:post_discount_revenue:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <panes><pane><mark class='Bar' /><encodings><tooltip column='[federated.params0demo].[sum:post_discount_revenue:qk]' /></encodings></pane></panes>
        <rows>[federated.params0demo].[none:status:nk]</rows>
        <cols>[federated.params0demo].[sum:Calculation_7601:qk]</cols>
      </table>
    </worksheet>
