<?xml version='1.0' encoding='utf-8' ?>
<workbook version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource caption='Orders' inline='true' name='federated.dates0demo' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse' name='postgres.dates'>
            <connection class='postgres' dbname='dunder_mifflin' server='warehouse.example.com' author-locale='en_US' />
          </named-connection>
        </named-connections>
        <relation connection='postgres.dates' name='orders' table='[public].[orders]' type='table' />
        <metadata-records>
          <metadata-record class='column'><remote-name>order_id</remote-name><local-name>[order_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>purchased_at</remote-name><local-name>[purchased_at]</local-name><parent-name>[orders]</parent-name><local-type>date</local-type></metadata-record>
          <metadata-record class='column'><remote-name>cancelled_at</remote-name><local-name>[cancelled_at]</local-name><parent-name>[orders]</parent-name><local-type>date</local-type></metadata-record>
          <metadata-record class='column'><remote-name>quantity</remote-name><local-name>[quantity]</local-name><parent-name>[orders]</parent-name><local-type>integer</local-type></metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
    <column caption="Week" datatype="date" name="[Calculation_100]" role="dimension" type="ordinal">
      <calculation class="tableau" formula="DATETRUNC(&apos;week&apos;, [purchased_at])" />
    </column>
    <column caption="Monday Week" datatype="date" name="[Calculation_101]" role="dimension" type="ordinal">
      <calculation class="tableau" formula="DATETRUNC(&apos;week&apos;, [purchased_at], &apos;monday&apos;)" />
    </column>
    <column caption="Quarter Start" datatype="date" name="[Calculation_102]" role="dimension" type="ordinal">
      <calculation class="tableau" formula="DATETRUNC(&apos;quarter&apos;, [purchased_at])" />
    </column>
    <column caption="Year Start" datatype="date" name="[Calculation_103]" role="dimension" type="ordinal">
      <calculation class="tableau" formula="DATETRUNC(&apos;year&apos;, [purchased_at])" />
    </column>
    <column caption="Week Number" datatype="integer" name="[Calculation_104]" role="dimension" type="ordinal">
      <calculation class="tableau" formula="DATEPART(&apos;week&apos;, [purchased_at])" />
    </column>
    <column caption="Weekday" datatype="integer" name="[Calculation_105]" role="dimension" type="ordinal">
      <calculation class="tableau" formula="DATEPART(&apos;weekday&apos;, [purchased_at])" />
    </column>
    <column caption="Weekday Monday Arg" datatype="integer" name="[Calculation_106]" role="dimension" type="ordinal">
      <calculation class="tableau" formula="DATEPART(&apos;weekday&apos;, [purchased_at], &apos;monday&apos;)" />
    </column>
    <column caption="Monday Week Number" datatype="integer" name="[Calculation_107]" role="dimension" type="ordinal">
      <calculation class="tableau" formula="DATEPART(&apos;week&apos;, [purchased_at], &apos;monday&apos;)" />
    </column>
    <column caption="Quarter Number" datatype="integer" name="[Calculation_108]" role="dimension" type="ordinal">
      <calculation class="tableau" formula="DATEPART(&apos;quarter&apos;, [purchased_at])" />
    </column>
    <column caption="Year Number" datatype="integer" name="[Calculation_109]" role="dimension" type="ordinal">
      <calculation class="tableau" formula="DATEPART(&apos;year&apos;, [purchased_at])" />
    </column>
    <column caption="Weekday Name" datatype="string" name="[Calculation_110]" role="dimension" type="ordinal">
      <calculation class="tableau" formula="DATENAME(&apos;weekday&apos;, [purchased_at])" />
    </column>
    <column caption="Week Name" datatype="string" name="[Calculation_111]" role="dimension" type="ordinal">
      <calculation class="tableau" formula="DATENAME(&apos;week&apos;, [purchased_at])" />
    </column>
    <column caption="Quarter Name" datatype="string" name="[Calculation_112]" role="dimension" type="ordinal">
      <calculation class="tableau" formula="DATENAME(&apos;quarter&apos;, [purchased_at])" />
    </column>
    <column caption="Year Name" datatype="string" name="[Calculation_113]" role="dimension" type="ordinal">
      <calculation class="tableau" formula="DATENAME(&apos;year&apos;, [purchased_at])" />
    </column>
    <column caption="Cancelled Week" datatype="date" name="[Calculation_114]" role="dimension" type="ordinal">
      <calculation class="tableau" formula="DATETRUNC(&apos;week&apos;, [cancelled_at])" />
    </column>
    </datasource>
  </datasources>
  <worksheets>
