      <aliases enabled='yes' />
      <column datatype='integer' name='[Row ID]' role='dimension' type='ordinal' />
      <column datatype='real' name='[Sales]' role='measure' type='quantitative'>
        <desc>
          <formatted-text>
            <run>Gross sales in USD, before discounts.</run>
          </formatted-text>
        </desc>
      </column>
      <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column caption='Order Count' datatype='integer' name='[Calculation_2223334445556667778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID])' />
      </column>
      <column caption='Total Sales' datatype='real' name='[Calculation_5911432209381093376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])' />
      </column>
      <column caption='Profit Ratio' datatype='real' default-format='p0.0%' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// aggregate first, then divide&#13;&#10;SUM([Profit])/SUM([Sales])' />
        <desc>
          <formatted-text>
            <run>Profit as a share of sales.</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Margin %' datatype='real' name='[Calculation_9012345678901234560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1368249927221915648] * 100' />
      </column>
      <column caption='Profit per Order' datatype='real' name='[Calculation_1112223334445556667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / COUNTD([Order ID])' />
      </column>
      <column caption='Order Size' datatype='string' name='[Calculation_0831003198374240256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sales] &gt;= 500 THEN &quot;Large&quot;&#13;&#10;ELSEIF [Sales] &gt;= 100 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;Small&quot;&#13;&#10;END' />
      </column>
      <column caption='Net Sales' datatype='real' name='[Calculation_2451176542135316480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales] * (1 - IFNULL([Discount], 0))' />
      </column>
      <column caption='Order Month' datatype='date' name='[Calculation_7740912383420477440]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Order Date])' />
      </column>
      <column caption='Customer Count' datatype='integer' name='[Calculation_1650987234091827200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer Name])' />
      </column>
      <column caption='Safe Profit' datatype='real' name='[Calculation_1650987234091827201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([Profit]))' />
      </column>
      <column caption='Customer First Order' datatype='date' name='[Calculation_4410294812233412608]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [Customer Name] : MIN([Order Date])}' />
      </column>
      <column caption='Running Sales' datatype='real' name='[Calculation_8123450098712345600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM([Sales]), FIRST(), 0)' />
      </column>
      <column caption='Category Label' datatype='string' name='[Calculation_5556667778889990001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ATTR([Category])' />
      </column>
      <column caption='Above Target' datatype='boolean' name='[Calculation_6612345098712340992]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1368249927221915648] &gt; [Parameters].[Parameter 1]' />
      </column>
      <column caption='Regional Manager Filter' datatype='boolean' name='[Calculation_3301928475610293248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Regional Manager] = USERNAME()' />
      </column>
      <column caption='Manager or Executive' datatype='boolean' name='[Calculation_3301928475610293249]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISMEMBEROF(&apos;Executives&apos;) OR [Regional Manager] = USERNAME()' />
      </column>
      <column caption='Sales (bin)' datatype='integer' name='[Sales (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[Sales]' peg='0' size='100' />
      </column>
      <column caption='Region (group)' datatype='string' name='[Region (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Region]' new-bin='true'>
          <bin default-name='false' value='&quot;Coasts&quot;'>
            <value>&quot;East&quot;</value>
            <value>&quot;West&quot;</value>
          </bin>
        </calculation>
      </column>
      <group caption='Top Customers Set' name='[Top Customers Set]' name-style='unqualified' user:ui-builder='filter-group'>
        <groupfilter count='20' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
          <groupfilter direction='DESC' expression='SUM([Sales])' function='order' user:ui-marker='order'>
            <groupfilter function='level-members' level='[Customer Name]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </groupfilter>
        </groupfilter>
      </group>
      <filter class='categorical' column='[Calculation_3301928475610293248]' filter-group='2'>
        <groupfilter function='member' level='[Calculation_3301928475610293248]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
      </filter>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
