      <aliases enabled='yes' />
      <column caption='Revenue' datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' />
      <column caption="Discount Tier" datatype='string' name='[Calculation_7401]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [discount_percentage] &gt;= 10 THEN "High" ELSEIF [discount_percentage] &gt; 0 THEN "Low" END' /></column>
      <column caption="Account Revenue" datatype='real' name='[Calculation_7402]' role='measure' type='quantitative'><calculation class='tableau' formula="{FIXED [account_id] : SUM([post_discount_revenue])}" /></column>
      <date-options start-of-week='sunday' />
      <filter class='categorical' column='[status]' filter-group='2'>
        <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
          <groupfilter function='level-members' level='[status]' />
          <groupfilter function='member' level='[status]' member='&quot;CANCELLED&quot;' />
        </groupfilter>
      </filter>
      <extract count='-1' enabled='true' units='records'>
        <connection class='hyper' dbname='Data/Extracts/orders.hyper' schema='Extract' tablename='Extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </connection>
        <filter class='quantitative' column='[quantity]' included-values='in-range'><min>2</min></filter>
      </extract>
    </datasource>
  </datasources>
