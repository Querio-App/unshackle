<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2024.2.0 (20242.24.0613.0835)' source-platform='mac' version='18.1' locale='en_US' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <repository-location id='ExtractSales' path='/t/example/workbooks' revision='' site='example' />
  <datasources>
    <datasource caption='Order Lines' inline='true' name='sqlproxy.0order0lines' version='18.1'>
      <connection channel='https' class='sqlproxy' dbname='OrderLines' directory='/dataserver' port='443' server='example.online.tableau.com' username=''>
        <relation name='sqlproxy' table='[sqlproxy]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column caption='Revenue' datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' />
    </datasource>
    <datasource caption='Order History' inline='true' name='sqlproxy.0order0history' version='18.1'>
      <connection channel='https' class='sqlproxy' dbname='OrderHistory' directory='/dataserver' port='443' server='example.online.tableau.com' username=''>
        <relation name='sqlproxy' table='[sqlproxy]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column caption='Revenue' datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' />
    </datasource>
    <datasource caption='Accounts' inline='true' name='federated.0accounts0xlsx' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Accounts' name='excel-direct.0accounts'>
            <connection class='excel-direct' cleaning='no' compat='no' dataRefreshTime='' filename='Data/Accounts.xlsx' interpretationMode='0' server='' validate='no' />
          </named-connection>
        </named-connections>
        <relation connection='excel-direct.0accounts' name='Accounts' table='[Accounts$]' type='table' />
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>account_id</remote-name>
            <remote-type>129</remote-type>
            <local-name>[account_id]</local-name>
            <parent-name>[Accounts]</parent-name>
            <remote-alias>account_id</remote-alias>
            <ordinal>7</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>account_name</remote-name>
            <remote-type>129</remote-type>
            <local-name>[account_name]</local-name>
            <parent-name>[Accounts]</parent-name>
            <remote-alias>account_name</remote-alias>
            <ordinal>8</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>business_size</remote-name>
            <remote-type>20</remote-type>
            <local-name>[business_size]</local-name>
            <parent-name>[Accounts]</parent-name>
            <remote-alias>business_size</remote-alias>
            <ordinal>9</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>payment_cycle</remote-name>
            <remote-type>129</remote-type>
            <local-name>[payment_cycle]</local-name>
            <parent-name>[Accounts]</parent-name>
            <remote-alias>payment_cycle</remote-alias>
            <ordinal>10</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>account_manager</remote-name>
            <remote-type>129</remote-type>
            <local-name>[account_manager]</local-name>
            <parent-name>[Accounts]</parent-name>
            <remote-alias>account_manager</remote-alias>
            <ordinal>11</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
    </datasource>
    <datasource caption='Products' inline='true' name='federated.0products0csv' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='products' name='textscan.0products'>
            <connection class='textscan' directory='Data/Products' filename='products.csv' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.0products' name='products.csv' table='[products#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='product_id' ordinal='0' />
            <column datatype='string' name='product_name' ordinal='1' />
            <column datatype='string' name='paper_type' ordinal='2' />
            <column datatype='real' name='price' ordinal='3' />
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>product_id</remote-name>
            <remote-type>129</remote-type>
            <local-name>[product_id]</local-name>
            <parent-name>[products.csv]</parent-name>
            <remote-alias>product_id</remote-alias>
            <ordinal>0</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>product_name</remote-name>
            <remote-type>129</remote-type>
            <local-name>[product_name]</local-name>
            <parent-name>[products.csv]</parent-name>
            <remote-alias>product_name</remote-alias>
            <ordinal>1</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>paper_type</remote-name>
            <remote-type>129</remote-type>
            <local-name>[paper_type]</local-name>
            <parent-name>[products.csv]</parent-name>
            <remote-alias>paper_type</remote-alias>
            <ordinal>2</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>price</remote-name>
            <remote-type>5</remote-type>
            <local-name>[price]</local-name>
            <parent-name>[products.csv]</parent-name>
            <remote-alias>price</remote-alias>
            <ordinal>3</ordinal>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Revenue by Paper Type">
      <table>
        <view>
          <datasources><datasource name='sqlproxy.0order0lines' /></datasources>
          <datasource-dependencies datasource='sqlproxy.0order0lines'>
            <column datatype='string' name='[paper_type]' role='dimension' type='nominal' /><column caption='Revenue' datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' /><column datatype='string' name='[status]' role='dimension' type='nominal' /><column-instance column='[paper_type]' derivation='None' name='[none:paper_type:nk]' pivot='key' type='nominal' /><column-instance column='[post_discount_revenue]' derivation='Sum' name='[sum:post_discount_revenue:qk]' pivot='key' type='quantitative' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[sqlproxy.0order0lines].[none:status:nk]'><groupfilter function='member' level='[none:status:nk]' member='&quot;COMPLETED&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' /></filter>
          <aggregation value='true' />
        </view>
        <style />
        <panes><pane><view><breakdown value='auto' /></view><mark class='Bar' /></pane></panes>
        <rows>[sqlproxy.0order0lines].[none:paper_type:nk]</rows>
        <cols>[sqlproxy.0order0lines].[sum:post_discount_revenue:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Monthly Orders">
      <table>
        <view>
          <datasources><datasource name='sqlproxy.0order0lines' /></datasources>
          <datasource-dependencies datasource='sqlproxy.0order0lines'>
            <column datatype='date' name='[purchased_at]' role='dimension' type='ordinal' /><column datatype='string' name='[order_id]' role='dimension' type='nominal' /><column-instance column='[purchased_at]' derivation='Month-Trunc' name='[tmn:purchased_at:qk]' pivot='key' type='quantitative' /><column-instance column='[order_id]' derivation='CountD' name='[ctd:order_id:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style />
        <panes><pane><view><breakdown value='auto' /></view><mark class='Line' /></pane></panes>
        <rows>[sqlproxy.0order0lines].[ctd:order_id:qk]</rows>
        <cols>[sqlproxy.0order0lines].[tmn:purchased_at:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Cancelled Revenue by Status">
      <table>
        <view>
          <datasources><datasource name='sqlproxy.0order0history' /></datasources>
          <datasource-dependencies datasource='sqlproxy.0order0history'>
            <column datatype='string' name='[status]' role='dimension' type='nominal' /><column caption='Revenue' datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[post_discount_revenue]' derivation='Sum' name='[sum:post_discount_revenue:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style />
        <panes><pane><view><breakdown value='auto' /></view><mark class='Bar' /></pane></panes>
        <rows>[sqlproxy.0order0history].[none:status:nk]</rows>
        <cols>[sqlproxy.0order0history].[sum:post_discount_revenue:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Business Size by Payment Cycle">
      <table>
        <view>
          <datasources><datasource name='federated.0accounts0xlsx' /></datasources>
          <datasource-dependencies datasource='federated.0accounts0xlsx'>
            <column datatype='string' name='[payment_cycle]' role='dimension' type='nominal' /><column datatype='integer' name='[business_size]' role='measure' type='quantitative' /><column-instance column='[payment_cycle]' derivation='None' name='[none:payment_cycle:nk]' pivot='key' type='nominal' /><column-instance column='[business_size]' derivation='Sum' name='[sum:business_size:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style />
        <panes><pane><view><breakdown value='auto' /></view><mark class='Bar' /></pane></panes>
        <rows>[federated.0accounts0xlsx].[none:payment_cycle:nk]</rows>
        <cols>[federated.0accounts0xlsx].[sum:business_size:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Average Price by Paper Type">
      <table>
        <view>
          <datasources><datasource name='federated.0products0csv' /></datasources>
          <datasource-dependencies datasource='federated.0products0csv'>
            <column datatype='string' name='[paper_type]' role='dimension' type='nominal' /><column datatype='real' name='[price]' role='measure' type='quantitative' /><column-instance column='[paper_type]' derivation='None' name='[none:paper_type:nk]' pivot='key' type='nominal' /><column-instance column='[price]' derivation='Avg' name='[avg:price:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style />
        <panes><pane><view><breakdown value='auto' /></view><mark class='Bar' /></pane></panes>
        <rows>[federated.0products0csv].[none:paper_type:nk]</rows>
        <cols>[federated.0products0csv].[avg:price:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
</workbook>
