          <datasource-dependencies datasource='federated.tablecalc0'><column datatype='string' name='[status]' role='dimension' type='nominal' /><column datatype='string' name='[paper_type]' role='dimension' type='nominal' /><column caption="Revenue" datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /><column-instance column='[paper_type]' derivation='None' name='[none:paper_type:nk]' pivot='key' type='nominal' /><column-instance column='[post_discount_revenue]' derivation='Sum' name='[cum:sum:post_discount_revenue:qk:3]' pivot='key' type='quantitative'><table-calc aggregation="Sum" ordering-type="Table" type="CumTotal" /></column-instance></datasource-dependencies>
          
