<?xml version='1.0' encoding='utf-8' ?>
<workbook version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource caption='Dunder Mifflin Table Calcs' inline='true' name='federated.tablecalc0' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse' name='postgres.tablecalc'>
            <connection class='postgres' dbname='dunder_mifflin' server='warehouse.example.com' />
          </named-connection>
        </named-connections>
        <relation join='inner' type='join'>
          <clause type='join'><expression op='='><expression op='[orders].[product_id]' /><expression op='[products].[product_id]' /></expression></clause>
          <relation join='inner' type='join'>
            <clause type='join'><expression op='='><expression op='[orders].[account_id]' /><expression op='[accounts].[account_id]' /></expression></clause>
            <relation connection='postgres.tablecalc' name='orders' table='[public].[orders]' type='table' />
            <relation connection='postgres.tablecalc' name='accounts' table='[public].[accounts]' type='table' />
          </relation>
          <relation connection='postgres.tablecalc' name='products' table='[public].[products]' type='table' />
        </relation>
        <cols>
      <map key='[order_id]' value='[orders].[order_id]' />
      <map key='[status]' value='[orders].[status]' />
      <map key='[purchased_at]' value='[orders].[purchased_at]' />
      <map key='[quantity]' value='[orders].[quantity]' />
      <map key='[pre_discount_revenue]' value='[orders].[pre_discount_revenue]' />
      <map key='[post_discount_revenue]' value='[orders].[post_discount_revenue]' />
      <map key='[account_id]' value='[orders].[account_id]' />
      <map key='[product_id]' value='[orders].[product_id]' />
      <map key='[account_id (accounts)]' value='[accounts].[account_id]' />
      <map key='[account_name]' value='[accounts].[account_name]' />
      <map key='[payment_cycle]' value='[accounts].[payment_cycle]' />
      <map key='[account_manager]' value='[accounts].[account_manager]' />
      <map key='[business_size]' value='[accounts].[business_size]' />
      <map key='[product_id (products)]' value='[products].[product_id]' />
      <map key='[paper_type]' value='[products].[paper_type]' />
      <map key='[product_name]' value='[products].[product_name]' />
        </cols>
        <metadata-records>
      <metadata-record class='column'><remote-name>order_id</remote-name><local-name>[order_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>status</remote-name><local-name>[status]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>purchased_at</remote-name><local-name>[purchased_at]</local-name><parent-name>[orders]</parent-name><local-type>date</local-type></metadata-record>
      <metadata-record class='column'><remote-name>quantity</remote-name><local-name>[quantity]</local-name><parent-name>[orders]</parent-name><local-type>integer</local-type></metadata-record>
      <metadata-record class='column'><remote-name>pre_discount_revenue</remote-name><local-name>[pre_discount_revenue]</local-name><parent-name>[orders]</parent-name><local-type>real</local-type></metadata-record>
      <metadata-record class='column'><remote-name>post_discount_revenue</remote-name><local-name>[post_discount_revenue]</local-name><parent-name>[orders]</parent-name><local-type>real</local-type></metadata-record>
      <metadata-record class='column'><remote-name>account_id</remote-name><local-name>[account_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>product_id</remote-name><local-name>[product_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>account_id</remote-name><local-name>[account_id (accounts)]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>account_name</remote-name><local-name>[account_name]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>payment_cycle</remote-name><local-name>[payment_cycle]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>account_manager</remote-name><local-name>[account_manager]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>business_size</remote-name><local-name>[business_size]</local-name><parent-name>[accounts]</parent-name><local-type>integer</local-type></metadata-record>
      <metadata-record class='column'><remote-name>product_id</remote-name><local-name>[product_id (products)]</local-name><parent-name>[products]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>paper_type</remote-name><local-name>[paper_type]</local-name><parent-name>[products]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>product_name</remote-name><local-name>[product_name]</local-name><parent-name>[products]</parent-name><local-type>string</local-type></metadata-record>
        </metadata-records>
      </connection>
    <column datatype='string' name='[order_id]' role='dimension' type='nominal' />
    <column datatype='string' name='[status]' role='dimension' type='nominal' />
    <column datatype='date' name='[purchased_at]' role='dimension' type='ordinal' />
    <column caption="Quantity" datatype='integer' name='[quantity]' role='measure' type='quantitative' />
    <column caption="Revenue Before Discount" datatype='real' name='[pre_discount_revenue]' role='measure' type='quantitative' />
    <column caption="Revenue" datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' />
    <column datatype='string' name='[account_id]' role='dimension' type='nominal' />
    <column datatype='string' name='[product_id]' role='dimension' type='nominal' />
    <column datatype='string' name='[account_id (accounts)]' role='dimension' type='nominal' />
    <column datatype='string' name='[account_name]' role='dimension' type='nominal' />
    <column datatype='string' name='[payment_cycle]' role='dimension' type='nominal' />
    <column datatype='string' name='[account_manager]' role='dimension' type='nominal' />
    <column datatype='integer' name='[business_size]' role='measure' type='quantitative' />
    <column datatype='string' name='[product_id (products)]' role='dimension' type='nominal' />
    <column datatype='string' name='[paper_type]' role='dimension' type='nominal' />
    <column datatype='string' name='[product_name]' role='dimension' type='nominal'><aliases><alias key='"Ledger 24lb Paper, 11 x 17 Tabloid, Bright White Wove, 500 Sheets/Ream"' value="alpha ledger" /><alias key='"Premium 24lb Paper, 8.5 x 11, Ivory Wove, 100 Sheets/Pack"' value="Beta Premium" /><alias key='"Copy Paper, 20 lbs., 92 Brightness, 500 Sheets/Ream, 40 Cases/Pallet"' value="Zeta Copy" /><alias key='"Bulk Copy Paper, 92 Brightness, 20lb, 8-1/2 X 11, White, 200,000 Sheets/CT"' value="Copy Bulk" /></aliases></column>
    <column caption="Completed Revenue" datatype='real' name='[Calculation_7201]' role='measure' type='quantitative'><calculation class='tableau' formula='IF [status] = "COMPLETED" THEN [post_discount_revenue] END'></calculation></column>
    <column caption="Discount Amount" datatype='real' name='[Calculation_7202]' role='measure' type='quantitative'><calculation class='tableau' formula="[post_discount_revenue] - [pre_discount_revenue]"></calculation></column>
    <column caption="Running Revenue" datatype='real' name='[Calculation_7211]' role='measure' type='quantitative'><calculation class='tableau' formula="RUNNING_SUM(SUM([post_discount_revenue]))"></calculation></column>
    <column caption="Revenue Share" datatype='real' name='[Calculation_7212]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([post_discount_revenue]) / TOTAL(SUM([post_discount_revenue]))"></calculation></column>
    <column caption="Quantity vs Average" datatype='real' name='[Calculation_7213]' role='measure' type='quantitative'><calculation class='tableau' formula="AVG([quantity]) / TOTAL(AVG([quantity]))"></calculation></column>
    <column caption="Centered Average" datatype='real' name='[Calculation_7214]' role='measure' type='quantitative'><calculation class='tableau' formula="WINDOW_AVG(SUM([post_discount_revenue]), -1, 1)"></calculation></column>
    <column caption="Partition Max" datatype='real' name='[Calculation_7215]' role='measure' type='quantitative'><calculation class='tableau' formula="WINDOW_MAX(SUM([post_discount_revenue]))"></calculation></column>
    <column caption="Previous Revenue" datatype='real' name='[Calculation_7216]' role='measure' type='quantitative'><calculation class='tableau' formula="LOOKUP(SUM([post_discount_revenue]), -1)"></calculation></column>
    <column caption="Next Revenue" datatype='real' name='[Calculation_7217]' role='measure' type='quantitative'><calculation class='tableau' formula="LOOKUP(SUM([post_discount_revenue]), 1)"></calculation></column>
    <column caption="Row Index" datatype='integer' name='[Calculation_7218]' role='measure' type='quantitative'><calculation class='tableau' formula="INDEX()"></calculation></column>
    <column caption="Partition Size" datatype='integer' name='[Calculation_7219]' role='measure' type='quantitative'><calculation class='tableau' formula="SIZE()"></calculation></column>
    <column caption="Revenue Rank Asc" datatype='integer' name='[Calculation_7220]' role='measure' type='quantitative'><calculation class='tableau' formula="RANK(SUM([post_discount_revenue]), 'asc')"></calculation></column>
    <column caption="Revenue To Date" datatype='real' name='[Calculation_7221]' role='measure' type='quantitative'><calculation class='tableau' formula="WINDOW_SUM(SUM([post_discount_revenue]), FIRST(), 0)"></calculation></column>
    <column caption="Offset From First" datatype='integer' name='[Calculation_7222]' role='measure' type='quantitative'><calculation class='tableau' formula="FIRST()"></calculation></column>
    <column caption="Offset To Last" datatype='integer' name='[Calculation_7223]' role='measure' type='quantitative'><calculation class='tableau' formula="LAST()"></calculation></column>
    <column caption="Running Avg Completed" datatype='real' name='[Calculation_7224]' role='measure' type='quantitative'><calculation class='tableau' formula="RUNNING_AVG(SUM([Calculation_7201]))"></calculation></column>
    <column caption="Completed Rank" datatype='integer' name='[Calculation_7225]' role='measure' type='quantitative'><calculation class='tableau' formula="RANK(SUM([Calculation_7201]))"></calculation></column>
    <column caption="Revenue From Here" datatype='real' name='[Calculation_7226]' role='measure' type='quantitative'><calculation class='tableau' formula="WINDOW_SUM(SUM([post_discount_revenue]), 0, LAST())"></calculation></column>
    <column caption="First Revenue" datatype='real' name='[Calculation_7227]' role='measure' type='quantitative'><calculation class='tableau' formula="LOOKUP(SUM([post_discount_revenue]), FIRST())"></calculation></column>
    <column caption="Rank Over Three" datatype='real' name='[Calculation_7228]' role='measure' type='quantitative'><calculation class='tableau' formula="ROUND(INDEX() / 3 - 0.6, 0) + 1"><table-calc ordering-type='Columns' /></calculation></column>
    <column caption="Max Quantity Dense Rank" datatype='integer' name='[Calculation_7229]' role='measure' type='quantitative'><calculation class='tableau' formula="RANK_DENSE(MAX([quantity]))"></calculation></column>
    <column caption="Max Quantity Unique Rank" datatype='integer' name='[Calculation_7230]' role='measure' type='quantitative'><calculation class='tableau' formula="RANK_UNIQUE(MAX([quantity]))"></calculation></column>
    <column caption="Max Quantity Modified Rank" datatype='integer' name='[Calculation_7231]' role='measure' type='quantitative'><calculation class='tableau' formula="RANK_MODIFIED(MAX([quantity]))"></calculation></column>
    <column caption="Max Quantity Percentile" datatype='real' name='[Calculation_7232]' role='measure' type='quantitative'><calculation class='tableau' formula="RANK_PERCENTILE(MAX([quantity]))"></calculation></column>
    <column caption="Max Quantity Rank" datatype='integer' name='[Calculation_7233]' role='measure' type='quantitative'><calculation class='tableau' formula="RANK(MAX([quantity]))"></calculation></column>
    <column caption="Index Default" datatype='integer' name='[Calculation_7234]' role='measure' type='quantitative'><calculation class='tableau' formula="INDEX()"></calculation></column>
    <column caption="Running Count" datatype='integer' name='[Calculation_7235]' role='measure' type='quantitative'><calculation class='tableau' formula="RUNNING_COUNT(SUM([post_discount_revenue]))"></calculation></column>
    <column caption="Running Min" datatype='real' name='[Calculation_7236]' role='measure' type='quantitative'><calculation class='tableau' formula="RUNNING_MIN(SUM([post_discount_revenue]))"></calculation></column>
    <column caption="Window Count Back" datatype='integer' name='[Calculation_7237]' role='measure' type='quantitative'><calculation class='tableau' formula="WINDOW_COUNT(SUM([post_discount_revenue]), -1, 0)"></calculation></column>
    <column caption="Last Revenue" datatype='real' name='[Calculation_7238]' role='measure' type='quantitative'><calculation class='tableau' formula="LOOKUP(SUM([post_discount_revenue]), LAST())"></calculation></column>
    <column caption="Min Share" datatype='real' name='[Calculation_7239]' role='measure' type='quantitative'><calculation class='tableau' formula="MIN([post_discount_revenue]) / TOTAL(MIN([post_discount_revenue]))"></calculation></column>
    <column caption="Orders Share" datatype='real' name='[Calculation_7243]' role='measure' type='quantitative'><calculation class='tableau' formula="COUNT([order_id]) / TOTAL(COUNT([order_id]))"></calculation></column>
    <column caption="Ratio Running" datatype='real' name='[Calculation_7244]' role='measure' type='quantitative'><calculation class='tableau' formula="RUNNING_SUM(SUM([post_discount_revenue]) / SUM([quantity]))"></calculation></column>
    <column caption="Ratio Share" datatype='real' name='[Calculation_7245]' role='measure' type='quantitative'><calculation class='tableau' formula="(SUM([post_discount_revenue]) / SUM([quantity])) / TOTAL(SUM([post_discount_revenue]) / SUM([quantity]))"></calculation></column>
    <column caption="Revenue Rank" datatype='integer' name='[Calculation_7246]' role='measure' type='quantitative'><calculation class='tableau' formula="RANK(SUM([post_discount_revenue]))"></calculation></column>
    <column caption="Running of Running" datatype='real' name='[Calculation_7240]' role='measure' type='quantitative'><calculation class='tableau' formula="RUNNING_SUM([Calculation_7211])"></calculation></column>
    <column caption="Previous Value" datatype='real' name='[Calculation_7241]' role='measure' type='quantitative'><calculation class='tableau' formula="PREVIOUS_VALUE(0) + SUM([post_discount_revenue])"></calculation></column>
    <column caption="Script Value" datatype='real' name='[Calculation_7242]' role='measure' type='quantitative'><calculation class='tableau' formula="SCRIPT_REAL('return _arg1', SUM([post_discount_revenue]))"></calculation></column>
    <column caption="Open Status" datatype='string' name='[Calculation_7250]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [status] &lt;&gt; "COMPLETED" THEN [status] END'></calculation></column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Running Total by Month">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Table Calcs' name='federated.tablecalc0' /></datasources>
          <datasource-dependencies datasource='federated.tablecalc0'><column caption="Revenue" datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' /><column datatype='date' name='[purchased_at]' role='dimension' type='ordinal' /><column-instance column='[post_discount_revenue]' derivation='Sum' name='[cum:sum:post_discount_revenue:qk]' pivot='key' type='quantitative'><table-calc aggregation="Sum" ordering-type="Rows" type="CumTotal" /></column-instance><column-instance column='[purchased_at]' derivation='Month-Trunc' name='[tmn:purchased_at:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            
          </pane>
        </panes>
        <rows>[federated.tablecalc0].[cum:sum:post_discount_revenue:qk]</rows>
        <cols>[federated.tablecalc0].[tmn:purchased_at:qk]</cols>
      </table>
      <simple-id uuid='{758ED79C-9C11-5143-88D1-01B84B7148D7}' />
    </worksheet>
    <worksheet name="Running Total by Status">
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Table Calcs' name='federated.tablecalc0' /></datasources>
          <datasource-dependencies datasource='federated.tablecalc0'><column caption="Revenue" datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' /><column datatype='date' name='[purchased_at]' role='dimension' type='ordinal' /><column datatype='string' name='[status]' role='dimension' type='nominal' /><column-instance column='[post_discount_revenue]' derivation='Sum' name='[cum:sum:post_discount_revenue:qk]' pivot='key' type='quantitative'><table-calc aggregation="Sum" ordering-type="Rows" type="CumTotal" /></column-instance><column-instance column='[purchased_at]' derivation='Month-Trunc' name='[tmn:purchased_at:qk]' pivot='key' type='quantitative' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' /></datasource-dependencies>
          
          <aggregation value='true' />
