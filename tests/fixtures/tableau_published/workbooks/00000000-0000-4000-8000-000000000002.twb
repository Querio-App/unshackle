<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2024.2.0 (20242.24.0613.0835)' source-platform='mac' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <repository-location id='DunderMifflinSales' path='/t/example/workbooks' revision='' site='example' />
  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='Min Order Value' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='500.0'><calculation class='tableau' formula='500.0' /><range granularity='50.0' max='5000.0' min='0.0' /></column>
    </datasource>
    <datasource caption='Dunder Mifflin Orders' inline='true' name='sqlproxy.0dunder0mifflin' version='18.1'>
      <repository-location derived-from='https://example.online.tableau.com/t/example/datasources/DunderMifflinOrders?rev=1.0' id='DunderMifflinOrders' path='/t/example/datasources' revision='1.0' site='example' />
      <connection channel='https' class='sqlproxy' dbname='DunderMifflinOrders' directory='/dataserver' port='443' server='example.online.tableau.com' username=''>
        <relation name='sqlproxy' table='[sqlproxy]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column caption='Revenue' datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' />
      <column datatype='integer' name='[days_to_close]' role='measure' type='quantitative' />
      <column caption="Large Order" datatype='boolean' name='[Calculation_2001]' role='dimension' type='nominal'><calculation class='tableau' formula="[post_discount_revenue] &gt;= [Parameters].[Parameter 1]" /></column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Revenue by Paper Type">
      <table>
        <view>
          <datasources>
            <datasource caption='Dunder Mifflin Orders' name='sqlproxy.0dunder0mifflin' />
            
          </datasources>
          
          <datasource-dependencies datasource='sqlproxy.0dunder0mifflin'>
            <column datatype='string' name='[paper_type]' role='dimension' type='nominal' /><column caption="Revenue" datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' /><column datatype='string' name='[status]' role='dimension' type='nominal' /><column-instance column='[paper_type]' derivation='None' name='[none:paper_type:nk]' pivot='key' type='nominal' /><column-instance column='[post_discount_revenue]' derivation='Sum' name='[sum:post_discount_revenue:qk]' pivot='key' type='quantitative' /><column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[sqlproxy.0dunder0mifflin].[none:status:nk]'><groupfilter function='member' level='[none:status:nk]' member='&quot;COMPLETED&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' /></filter>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            
          </pane>
        </panes>
        <rows>[sqlproxy.0dunder0mifflin].[none:paper_type:nk]</rows>
        <cols>[sqlproxy.0dunder0mifflin].[sum:post_discount_revenue:qk]</cols>
      </table>
      <simple-id uuid='{811E2446-A4B5-52C7-99B1-47AD8DCA4C30}' />
    </worksheet>
    <worksheet name="Monthly Revenue">
      <table>
        <view>
          <datasources>
            <datasource caption='Dunder Mifflin Orders' name='sqlproxy.0dunder0mifflin' />
            
          </datasources>
          
          <datasource-dependencies datasource='sqlproxy.0dunder0mifflin'>
            <column datatype='date' name='[purchased_at]' role='dimension' type='ordinal' /><column caption="Revenue" datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' /><column-instance column='[purchased_at]' derivation='Month-Trunc' name='[tmn:purchased_at:qk]' pivot='key' type='quantitative' /><column-instance column='[post_discount_revenue]' derivation='Sum' name='[sum:post_discount_revenue:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            
          </pane>
        </panes>
        <rows>[sqlproxy.0dunder0mifflin].[sum:post_discount_revenue:qk]</rows>
        <cols>[sqlproxy.0dunder0mifflin].[tmn:purchased_at:qk]</cols>
      </table>
      <simple-id uuid='{DE65D625-342B-524B-A41A-C2FC3611573F}' />
    </worksheet>
    <worksheet name="Average Order Value">
      <table>
        <view>
          <datasources>
            <datasource caption='Dunder Mifflin Orders' name='sqlproxy.0dunder0mifflin' />
            
          </datasources>
          
          <datasource-dependencies datasource='sqlproxy.0dunder0mifflin'>
            <column caption="Average Order Value" datatype='real' name='[Calculation_1001]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([post_discount_revenue]) / COUNTD([order_id])" /></column><column-instance column='[Calculation_1001]' derivation='User' name='[usr:Calculation_1001:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[sqlproxy.0dunder0mifflin].[usr:Calculation_1001:qk]' /></encodings>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
      <simple-id uuid='{25902D40-965D-5814-9016-4D1B1AF64DB7}' />
    </worksheet>
    <worksheet name="Large Orders by Account">
      <table>
        <view>
          <datasources>
            <datasource caption='Dunder Mifflin Orders' name='sqlproxy.0dunder0mifflin' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'><column caption='Min Order Value' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='500.0'><calculation class='tableau' formula='500.0' /><range granularity='50.0' max='5000.0' min='0.0' /></column></datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0dunder0mifflin'>
            <column datatype='string' name='[account_name]' role='dimension' type='nominal' /><column datatype='string' name='[order_id]' role='dimension' type='nominal' /><column caption="Revenue" datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' /><column caption="Large Order" datatype='boolean' name='[Calculation_2001]' role='dimension' type='nominal'><calculation class='tableau' formula="[post_discount_revenue] &gt;= [Parameters].[Parameter 1]" /></column><column-instance column='[account_name]' derivation='None' name='[none:account_name:nk]' pivot='key' type='nominal' /><column-instance column='[post_discount_revenue]' derivation='Sum' name='[sum:post_discount_revenue:qk]' pivot='key' type='quantitative' /><column-instance column='[order_id]' derivation='CountD' name='[ctd:order_id:qk]' pivot='key' type='quantitative' /><column-instance column='[Calculation_2001]' derivation='None' name='[none:Calculation_2001:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[sqlproxy.0dunder0mifflin].[none:Calculation_2001:nk]'><groupfilter function='member' level='[none:Calculation_2001:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' /></filter>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[sqlproxy.0dunder0mifflin].[sum:post_discount_revenue:qk]' /></encodings>
          </pane>
        </panes>
        <rows>[sqlproxy.0dunder0mifflin].[none:account_name:nk]</rows>
        <cols></cols>
      </table>
      <simple-id uuid='{C69BADF0-2B96-5EA3-A4E5-53F5E72EF8FF}' />
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Sales Overview'>
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Dunder Mifflin Orders' name='sqlproxy.0dunder0mifflin' />
      </datasources>
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='8000' id='2' type-v2='text' w='100000' x='0' y='0'><formatted-text><run bold='true'>Dunder Mifflin sales. </run><run>Revenue is after discounts.</run></formatted-text></zone><zone h='8000' id='3' mode='slider' param='[Parameters].[Parameter 1]' type-v2='paramctrl' w='30000' x='70000' y='0' /><zone h='42000' id='4' name="Average Order Value" w='30000' x='0' y='8000' /><zone h='42000' id='5' name="Monthly Revenue" w='70000' x='30000' y='8000' /><zone h='50000' id='6' name="Revenue by Paper Type" w='50000' x='0' y='50000' /><zone h='50000' id='7' name="Large Orders by Account" w='50000' x='50000' y='50000' />
        </zone>
      </zones>
      <simple-id uuid='{3336A04C-080B-53FF-AC9A-41D5B6510CA3}' />
    </dashboard>
  </dashboards>
  <windows source-height='30'>
    <window class='worksheet' name="Revenue by Paper Type" />
    <window class='worksheet' name="Monthly Revenue" />
    <window class='worksheet' name="Average Order Value" />
    <window class='worksheet' name="Large Orders by Account" />
    <window class='dashboard' maximized='true' name='Sales Overview'>
      <viewpoints><viewpoint name="Revenue by Paper Type" /><viewpoint name="Monthly Revenue" /><viewpoint name="Average Order Value" /><viewpoint name="Large Orders by Account" /></viewpoints>
      <active id='-1' />
    </window>
  </windows>
</workbook>
