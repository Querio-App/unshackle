  <worksheets>
    <worksheet name='Revenue by Status (two databases)'>
      <table>
        <view>
          <datasources><datasource caption='Orders and CRM Accounts' name='federated.xdb' /></datasources>
          <datasource-dependencies datasource='federated.xdb'>
            <column datatype='string' name='[status]' role='dimension' type='nominal' />
            <column datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative' />
            <column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
            <column-instance column='[post_discount_revenue]' derivation='Sum' name='[sum:post_discount_revenue:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes><pane><view><breakdown value='auto' /></view><mark class='Bar' /></pane></panes>
        <rows>[federated.xdb].[none:status:nk]</rows>
        <cols>[federated.xdb].[sum:post_discount_revenue:qk]</cols>
      </table>
    </worksheet>
