    <datasource caption='Orders (custom SQL)' inline='true' name='federated.ctx0customsql' version='18.1'>
      <connection class='federated'>
        <named-connections><named-connection caption='warehouse.example.com' name='postgres.ctx0s'><connection class='postgres' dbname='dunder_mifflin' port='5432' server='warehouse.example.com' username='reader' /></named-connection></named-connections>
        <relation connection='postgres.ctx0s' name='Custom SQL Query' type='text'>SELECT o.order_id, o.status, o.purchased_at, o.quantity, p.paper_type
FROM public.orders o
JOIN public.products p ON o.product_id = p.product_id
WHERE o.status = &lt;[Parameters].[Parameter 1]&gt;
  AND o.purchased_at &gt;= &lt;[Parameters].[Parameter 2]&gt;
  AND o.quantity &gt;= &lt;[Parameters].[Parameter 3]&gt;</relation>
        <metadata-records>
          <metadata-record class='column'><remote-name>order_id</remote-name><local-name>[order_id]</local-name><parent-name>[Custom SQL Query]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>status</remote-name><local-name>[status]</local-name><parent-name>[Custom SQL Query]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>purchased_at</remote-name><local-name>[purchased_at]</local-name><parent-name>[Custom SQL Query]</parent-name><local-type>date</local-type></metadata-record>
          <metadata-record class='column'><remote-name>quantity</remote-name><local-name>[quantity]</local-name><parent-name>[Custom SQL Query]</parent-name><local-type>integer</local-type></metadata-record>
          <metadata-record class='column'><remote-name>paper_type</remote-name><local-name>[paper_type]</local-name><parent-name>[Custom SQL Query]</parent-name><local-type>string</local-type></metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
    </datasource>
