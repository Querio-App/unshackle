<?xml version='1.0' encoding='utf-8' ?>
<workbook version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource caption='Dunder Mifflin Orders' inline='true' name='federated.dash0demo' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse' name='postgres.dash'>
            <connection class='postgres' dbname='dunder_mifflin' server='warehouse.example.com' />
          </named-connection>
        </named-connections>
        <relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[orders].[account_id]' />
              <expression op='[accounts].[account_id]' />
            </expression>
          </clause>
          <relation connection='postgres.dash' name='orders' table='[public].[orders]' type='table' />
          <relation connection='postgres.dash' name='accounts' table='[public].[accounts]' type='table' />
        </relation>
        <cols>
          <map key='[order_id]' value='[orders].[order_id]' />
          <map key='[status]' value='[orders].[status]' />
          <map key='[purchased_at]' value='[orders].[purchased_at]' />
          <map key='[quantity]' value='[orders].[quantity]' />
          <map key='[pre_discount_revenue]' value='[orders].[pre_discount_revenue]' />
          <map key='[post_discount_revenue]' value='[orders].[post_discount_revenue]' />
          <map key='[discount_percentage]' value='[orders].[discount_percentage]' />
          <map key='[order_contact_email]' value='[orders].[order_contact_email]' />
          <map key='[shipping_id]' value='[orders].[shipping_id]' />
          <map key='[account_id]' value='[orders].[account_id]' />
          <map key='[account_id (accounts)]' value='[accounts].[account_id]' />
          <map key='[account_manager]' value='[accounts].[account_manager]' />
          <map key='[payment_cycle]' value='[accounts].[payment_cycle]' />
          <map key='[business_size]' value='[accounts].[business_size]' />
        </cols>
        <metadata-records>
          <metadata-record class='column'><remote-name>order_id</remote-name><local-name>[order_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>status</remote-name><local-name>[status]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>purchased_at</remote-name><local-name>[purchased_at]</local-name><parent-name>[orders]</parent-name><local-type>date</local-type></metadata-record>
          <metadata-record class='column'><remote-name>quantity</remote-name><local-name>[quantity]</local-name><parent-name>[orders]</parent-name><local-type>integer</local-type></metadata-record>
          <metadata-record class='column'><remote-name>pre_discount_revenue</remote-name><local-name>[pre_discount_revenue]</local-name><parent-name>[orders]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>post_discount_revenue</remote-name><local-name>[post_discount_revenue]</local-name><parent-name>[orders]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>discount_percentage</remote-name><local-name>[discount_percentage]</local-name><parent-name>[orders]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>order_contact_email</remote-name><local-name>[order_contact_email]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>shipping_id</remote-name><local-name>[shipping_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>account_id</remote-name><local-name>[account_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>account_id</remote-name><local-name>[account_id (accounts)]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>account_manager</remote-name><local-name>[account_manager]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>payment_cycle</remote-name><local-name>[payment_cycle]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>business_size</remote-name><local-name>[business_size]</local-name><parent-name>[accounts]</parent-name><local-type>integer</local-type></metadata-record>
        </metadata-records>
      </connection>
      <column caption='Order' datatype='string' name='[order_id]' role='dimension' type='nominal' />
      <column caption='Status' datatype='string' name='[status]' role='dimension' type='nominal'>
        <desc><formatted-text><run>COMPLETED, CANCELLED or RETURNED</run></formatted-text></desc>
      </column>
      <column caption='Purchased' datatype='date' name='[purchased_at]' role='dimension' type='ordinal' />
      <column caption='Quantity' datatype='integer' name='[quantity]' role='measure' type='quantitative' />
      <column caption='Pre-Discount Revenue' datatype='real' hidden='true' name='[pre_discount_revenue]' role='measure' type='quantitative' />
      <column caption='Revenue' datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative'>
        <desc><formatted-text><run>Order revenue after discounts, in USD</run></formatted-text></desc>
      </column>
      <column caption='Discount %' datatype='real' name='[discount_percentage]' role='measure' type='quantitative' />
      <column caption='Contact Email' datatype='string' hidden='true' name='[order_contact_email]' role='dimension' type='nominal' />
      <column caption='Shipping' datatype='string' hidden='true' name='[shipping_id]' role='dimension' type='nominal' />
      <column caption='Account' datatype='string' name='[account_id]' role='dimension' type='nominal' />
      <column caption='Account (accounts)' datatype='string' hidden='true' name='[account_id (accounts)]' role='dimension' type='nominal' />
      <column caption='Account Manager' datatype='string' name='[account_manager]' role='dimension' type='nominal' />
      <column caption='Payment Cycle' datatype='string' name='[payment_cycle]' role='dimension' type='nominal' />
      <column caption='Business Size' datatype='integer' hidden='true' name='[business_size]' role='measure' type='quantitative' />
      <column caption='Discount Given' datatype='real' name='[Calculation_8301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pre_discount_revenue] - [post_discount_revenue])' />
        <desc><formatted-text><run>Revenue given away in discounts</run></formatted-text></desc>
      </column>
      <column caption='Shipped' datatype='boolean' name='[Calculation_8302]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([shipping_id])' />
      </column>
      <column caption='Old Margin' datatype='real' hidden='true' name='[Calculation_8303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([post_discount_revenue]) / SUM([quantity])' />
      </column>
      <group caption='Action (Status)' hidden='true' name='[Action (Status)]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[status]' />
        </groupfilter>
      </group>
      <group caption='Action (Payment Cycle,YEAR(Purchased))' hidden='true' name='[Action (Payment Cycle,YEAR(Purchased))]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[payment_cycle]' />
          <groupfilter function='level-members' level='[yr:purchased_at:ok]' />
        </groupfilter>
      </group>
      <group caption='Action (Account Manager)' hidden='true' name='[Action (Account Manager)]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[account_manager]' />
        </groupfilter>
      </group>
      <group caption='Top Managers' name='[Top Managers]' name-style='unqualified'>
        <groupfilter function='union'>
          <groupfilter function='member' level='[account_manager]' member='&quot;Dwight Schrute&quot;' />
          <groupfilter function='member' level='[account_manager]' member='&quot;Jim Halpert&quot;' />
        </groupfilter>
      </group>
      <folders-common>
        <folder name='Revenue'>
          <folder-item name='[post_discount_revenue]' type='field' />
          <folder-item name='[pre_discount_revenue]' type='field' />
          <folder-item name='[Calculation_8301]' type='field' />
        </folder>
        <folder name='Accounts'>
          <folder-item name='[account_id]' type='field' />
          <folder-item name='[account_manager]' type='field' />
          <folder-item name='[payment_cycle]' type='field' />
        </folder>
      </folders-common>
    </datasource>
  </datasources>
  <actions>
    <action caption='Filter by Status' name='[Action1_0001]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Sales Dashboard' type='sheet' worksheet='Revenue by Status' />
      <link caption='Filter by Status' delimiter=',' escape='\' expression='tsl:Sales Dashboard?%5Bfederated.dash0demo%5D.%5Bstatus%5D~s0=&lt;[status]~na&gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Revenue by Status' />
        <param name='target' value='Sales Dashboard' />
      </command>
    </action>
    <action caption='Drill into Cycle and Year' name='[Action2_0002]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Sales Dashboard' type='sheet' worksheet='Revenue by Cycle and Year' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Revenue by Status,Orders by Account Manager' />
        <param name='special-fields' value='all' />
        <param name='target' value='Sales Dashboard' />
      </command>
    </action>
    <action caption='Highlight Manager' name='[Action3_0003]'>
      <activation auto-clear='true' type='on-hover' />
      <source dashboard='Sales Dashboard' type='sheet'>
        <exclude-sheet name='Revenue by Status' />
      </source>
      <command command='tsc:brush'>
        <param name='exclude' value='Revenue by Status' />
        <param name='field-captions' value='Account Manager' />
        <param name='target' value='Sales Dashboard' />
      </command>
    </action>
    <action caption='Manager in CRM' name='[Action4_0004]'>
      <activation type='explicit' />
      <source dashboard='Sales Dashboard' type='sheet' worksheet='Orders by Account Manager' />
      <link caption='Manager in CRM' delimiter=',' escape='\' expression='https://crm.example.com/managers?name=&lt;[account_manager]~na&gt;' include-null='true' multi-select='false' url-escape='true' />
    </action>
    <edit-group-action caption='Pick Top Managers' name='[Action5_0005]'>
      <activation type='on-select' />
      <source dashboard='Sales Dashboard' type='sheet' worksheet='Orders by Account Manager' />
      <params>
        <param name='target-group' value='[federated.dash0demo].[Top Managers]' />
      </params>
    </edit-group-action>
  </actions>
  <worksheets>
    <worksheet name='Revenue by Status'>
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Orders' name='federated.dash0demo' /></datasources>
          <filter class='categorical' column='[federated.dash0demo].[none:payment_cycle:nk]' filter-group='3'>
            <groupfilter function='level-members' level='[none:payment_cycle:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
        </view>
        <panes><pane><mark class='Bar' /></pane></panes>
        <rows>[federated.dash0demo].[none:status:nk]</rows>
        <cols>[federated.dash0demo].[sum:post_discount_revenue:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Revenue by Cycle and Year'>
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Orders' name='federated.dash0demo' /></datasources>
          <filter class='categorical' column='[federated.dash0demo].[none:payment_cycle:nk]' filter-group='3'>
            <groupfilter function='level-members' level='[none:payment_cycle:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.dash0demo].[Action (Status)]'>
            <groupfilter function='level-members' level='[status]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.dash0demo].[none:purchased_at:qk]' filter-group='4' included-values='in-range'>
            <min>#2024-03-01#</min>
            <max>#2025-12-31#</max>
          </filter>
        </view>
        <panes><pane><mark class='Bar' /></pane></panes>
        <rows>[federated.dash0demo].[none:payment_cycle:nk]</rows>
        <cols>[federated.dash0demo].[yr:purchased_at:ok] / [federated.dash0demo].[sum:post_discount_revenue:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Orders by Account Manager'>
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Orders' name='federated.dash0demo' /></datasources>
          <filter class='categorical' column='[federated.dash0demo].[none:payment_cycle:nk]' filter-group='3'>
            <groupfilter function='level-members' level='[none:payment_cycle:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.dash0demo].[Action (Status)]'>
            <groupfilter function='level-members' level='[status]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.dash0demo].[none:purchased_at:qk]' filter-group='4' included-values='in-range'>
            <min>#2024-03-01#</min>
            <max>#2025-12-31#</max>
          </filter>
        </view>
        <panes><pane><mark class='Bar' /></pane></panes>
        <rows>[federated.dash0demo].[none:account_manager:nk]</rows>
        <cols>[federated.dash0demo].[ctd:order_id:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Quantity by Manager and Cycle'>
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Orders' name='federated.dash0demo' /></datasources>
          <filter class='categorical' column='[federated.dash0demo].[Action (Payment Cycle,YEAR(Purchased))]'>
            <groupfilter function='crossjoin' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[payment_cycle]' />
              <groupfilter function='level-members' level='[yr:purchased_at:ok]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.dash0demo].[Action (Account Manager)]'>
            <groupfilter function='level-members' level='[account_manager]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.dash0demo].[none:purchased_at:qk]' filter-group='4' included-values='in-range'>
            <min>#2024-03-01#</min>
            <max>#2025-12-31#</max>
          </filter>
        </view>
        <panes><pane><mark class='Bar' /><encodings><color column='[federated.dash0demo].[none:payment_cycle:nk]' /></encodings></pane></panes>
        <rows>[federated.dash0demo].[none:account_manager:nk]</rows>
        <cols>[federated.dash0demo].[sum:quantity:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Discount by Status'>
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Orders' name='federated.dash0demo' /></datasources>
        </view>
        <panes><pane><mark class='Bar' /></pane></panes>
        <rows>[federated.dash0demo].[none:status:nk]</rows>
        <cols>[federated.dash0demo].[usr:Calculation_8301:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Shipped Orders'>
      <table>
        <view>
          <datasources><datasource caption='Dunder Mifflin Orders' name='federated.dash0demo' /></datasources>
        </view>
        <panes><pane><mark class='Bar' /></pane></panes>
        <rows>[federated.dash0demo].[none:Calculation_8302:nk]</rows>
        <cols>[federated.dash0demo].[ctd:order_id:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Sales Dashboard'>
      <layout-options><caption><formatted-text><run>Revenue and orders; select a status to filter the other sheets.</run></formatted-text></caption></layout-options>
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='8000' id='2' type-v2='text' w='80000' x='0' y='0'>
            <formatted-text><run>Dunder Mifflin sales</run></formatted-text>
          </zone>
          <zone h='46000' id='3' name='Revenue by Status' w='40000' x='0' y='8000' />
          <zone h='46000' id='4' name='Revenue by Cycle and Year' w='40000' x='40000' y='8000' />
          <zone h='46000' id='5' name='Orders by Account Manager' w='40000' x='0' y='54000' />
          <zone h='46000' id='6' name='Quantity by Manager and Cycle' w='40000' x='40000' y='54000' />
          <zone h='10000' id='7' mode='checkdropdown' name='Revenue by Status' param='[federated.dash0demo].[none:payment_cycle:nk]' type-v2='filter' w='20000' x='80000' y='8000' />
          <zone h='10000' id='8' name='Revenue by Cycle and Year' param='[federated.dash0demo].[none:purchased_at:qk]' type-v2='filter' w='20000' x='80000' y='18000' />
          <zone h='20000' id='9' param='https://wiki.example.com/sales' type-v2='web' w='20000' x='80000' y='28000' />
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='1000' minheight='1000' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='20' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='30000' id='21' name='Revenue by Status' w='100000' x='0' y='0' />
              <zone h='10000' id='22' mode='checkdropdown' name='Revenue by Status' param='[federated.dash0demo].[none:payment_cycle:nk]' type-v2='filter' w='100000' x='0' y='30000' />
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
    </dashboard>
    <dashboard name='Sales Story' type='storyboard'>
      <layout-options><title><formatted-text><run>How the sales year went</run></formatted-text></title></layout-options>
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='80000' id='2' type-v2='flipboard' w='100000' x='0' y='20000'>
            <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
              <story-points>
                <story-point caption='The dashboard, as it opens.' captured-sheet='Sales Dashboard' id='1' />
                <story-point caption='Monthly accounts bring the most revenue.' captured-sheet='Revenue by Status' id='2'>
                  <capturedDeltas>
                    <worksheet name='Revenue by Status'>
                      <filter class='categorical' column='[federated.dash0demo].[none:payment_cycle:nk]' filter-group='3'>
                        <groupfilter function='member' level='[none:payment_cycle:nk]' member='&quot;MONTH&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
                      </filter>
                    </worksheet>
                  </capturedDeltas>
                </story-point>
                <story-point caption='Discounts are mostly on completed orders.' captured-sheet='Discount by Status' id='3'>
                  <capturedDeltas>
                    <worksheet name='Discount by Status'>
                      <rows>[federated.dash0demo].[none:payment_cycle:nk]</rows>
                    </worksheet>
                  </capturedDeltas>
                </story-point>
              </story-points>
            </flipboard>
          </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>
  <windows>
    <window class='dashboard' name='Sales Dashboard' />
    <window class='dashboard' name='Sales Story' />
  </windows>
</workbook>
