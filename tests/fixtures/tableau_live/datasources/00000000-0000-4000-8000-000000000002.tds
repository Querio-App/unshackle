  <aliases enabled='yes' />
  <column aggregation='Avg' datatype='integer' name='[days_to_close]' role='measure' type='quantitative' />
  <column caption='Revenue' datatype='real' name='[post_discount_revenue]' role='measure' type='quantitative'>
    <desc>
      <formatted-text>
        <run>Order revenue after discounts, in USD.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption='Average Order Value' datatype='real' name='[Calculation_1001]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([post_discount_revenue]) / COUNTD([order_id])' />
  </column>
  <column caption='Discount Band' datatype='string' name='[Calculation_1002]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [discount_percentage] &gt; 0 THEN &quot;Discounted&quot; ELSE &quot;Full price&quot; END' />
  </column>
  <column caption='Order Month' datatype='date' name='[Calculation_1003]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [purchased_at])' />
  </column>
  <column caption='Account Lifetime Revenue' datatype='real' name='[Calculation_1004]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{FIXED [account_id] : SUM([post_discount_revenue])}' />
  </column>
  <column caption='Manager Access' datatype='boolean' name='[Calculation_1005]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF ISMEMBEROF(&apos;unshackle-managers&apos;) THEN [account_manager] = USERNAME() ELSE TRUE END' />
  </column>
  <column caption='Total Revenue' datatype='real' name='[Calculation_1006]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([post_discount_revenue])' />
  </column>
  <drill-paths>
    <drill-path name='Product'>
      <field>[paper_type]</field>
      <field>[product_name]</field>
    </drill-path>
  </drill-paths>
  <filter class='categorical' column='[Calculation_1005]'>
    <groupfilter function='member' level='[Calculation_1005]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
  </filter>
  <extract count='-1' enabled='true' units='records'>
