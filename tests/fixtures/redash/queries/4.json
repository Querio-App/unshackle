  "query": "SELECT p.paper_type,\n       COUNT(*) AS orders,\n       SUM(o.quantity) AS units\nFROM orders o\nJOIN products p ON p.id = o.product_id\nWHERE o.status = '{{ status }}'\nGROUP BY 1\nORDER BY 2 DESC",
