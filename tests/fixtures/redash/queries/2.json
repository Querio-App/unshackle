  "query": "SELECT s.region,\n       s.mode,\n       SUM(o.post_discount_revenue) AS revenue\nFROM orders o\nJOIN shippings s ON s.order_id = o.id\nWHERE o.status = '{{ status }}'\nGROUP BY 1, 2\nORDER BY 1, 2",
