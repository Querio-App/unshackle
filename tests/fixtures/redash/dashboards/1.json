        "query": {
          "created_at": "2026-10-22T11:02:36.689Z",
          "data_source_id": 1,
          "description": "Revenue and orders per shipping region for one order status.",
          "id": 2,
          "is_archived": false,
          "is_draft": false,
          "is_safe": false,
          "latest_query_data_id": 2,
          "name": "Revenue by region",
          "options": {
            "parameters": [
              {
                "global": false,
                "locals": [],
                "name": "status",
                "parentQueryId": null,
                "title": "Status",
                "type": "text",
                "value": "COMPLETED"
              }
            ]
          },
          "query": "SELECT s.region,\n       s.mode,\n       SUM(o.post_discount_revenue) AS revenue\nFROM orders o\nJOIN shippings s ON s.order_id = o.id\nWHERE o.status = '{{ status }}'\nGROUP BY 1, 2\nORDER BY 1, 2",
          "query_hash": "8aae73e20a20f3de9fe42cecda7b2713",
