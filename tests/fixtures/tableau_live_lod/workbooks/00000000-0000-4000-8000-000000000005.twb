        <relation name='sqlproxy' table='[sqlproxy]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column caption='Account Revenue' datatype='real' name='[Calculation_3101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [account_id] : SUM([post_discount_revenue])}' />
      </column>
      <column caption='Account Tier' datatype='string' name='[Calculation_3102]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3101] &gt;= 1000000 THEN &quot;Large&quot; ELSEIF [Calculation_3101] &gt;= 250000 THEN &quot;Mid&quot; ELSE &quot;Small&quot; END' />
      </column>
      <column caption='Avg Account Revenue' datatype='real' name='[Calculation_3103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({FIXED [account_id] : SUM([post_discount_revenue])})' />
      </column>
      <column caption='First Order Date' datatype='date' name='[Calculation_3104]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [account_name] : MIN([purchased_at])}' />
      </column>
      <column caption='Avg Order Revenue' datatype='real' name='[Calculation_3105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({INCLUDE [order_id] : SUM([post_discount_revenue])})' />
      </column>
      <column caption='Cycle Revenue' datatype='real' name='[Calculation_3106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [paper_type] : SUM([post_discount_revenue])}' />
      </column>
      <column caption='Account Paper Revenue' datatype='real' name='[Calculation_3107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [account_id], [paper_type] : SUM([post_discount_revenue])}' />
      </column>
      <column caption='Share of Account Revenue' datatype='real' name='[Calculation_3108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[post_discount_revenue] / [Calculation_3101]' />
      </column>
      <column caption='Revenue Share' datatype='real' name='[Calculation_3109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([post_discount_revenue]) / SUM([Calculation_3101])' />
      </column>
      <column caption='Large Account Orders' datatype='integer' name='[Calculation_3110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3101] &gt;= 1000000 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Cycle Avg Account Revenue' datatype='real' name='[Calculation_3111]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [payment_cycle] : AVG({FIXED [account_id] : SUM([post_discount_revenue])})}' />
      </column>
