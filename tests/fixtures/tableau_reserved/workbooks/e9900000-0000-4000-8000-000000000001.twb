<?xml version='1.0' encoding='utf-8' ?>
<workbook version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource caption='Reserved Words' inline='true' name='federated.reserved0demo' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse' name='postgres.reserved'>
            <connection class='postgres' dbname='dunder_mifflin' server='warehouse.example.com' />
          </named-connection>
        </named-connections>
        <relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[orders].[product_id]' />
              <expression op='[products].[product_id]' />
            </expression>
          </clause>
          <relation join='inner' type='join'>
            <clause type='join'>
              <expression op='='>
                <expression op='[orders].[account_id]' />
                <expression op='[accounts].[account_id]' />
              </expression>
            </clause>
            <relation connection='postgres.reserved' name='orders' table='[public].[orders]' type='table' />
            <relation connection='postgres.reserved' name='accounts' table='[public].[accounts]' type='table' />
          </relation>
          <relation connection='postgres.reserved' name='products' table='[public].[products]' type='table' />
        </relation>
        <cols>
      <map key="[order_id]" value="[orders].[order_id]" />
      <map key="[quantity]" value="[orders].[quantity]" />
      <map key="[post_discount_revenue]" value="[orders].[post_discount_revenue]" />
      <map key="[account_id]" value="[orders].[account_id]" />
      <map key="[product_id]" value="[orders].[product_id]" />
      <map key="[account_id (accounts)]" value="[accounts].[account_id]" />
      <map key="[account_manager]" value="[accounts].[account_manager]" />
      <map key="[product_id (products)]" value="[products].[product_id]" />
      <map key="[paper_type]" value="[products].[paper_type]" />
        </cols>
        <metadata-records>
      <metadata-record class='column'><remote-name>order_id</remote-name><local-name>[order_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>quantity</remote-name><local-name>[quantity]</local-name><parent-name>[orders]</parent-name><local-type>integer</local-type></metadata-record>
      <metadata-record class='column'><remote-name>post_discount_revenue</remote-name><local-name>[post_discount_revenue]</local-name><parent-name>[orders]</parent-name><local-type>real</local-type></metadata-record>
      <metadata-record class='column'><remote-name>account_id</remote-name><local-name>[account_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>product_id</remote-name><local-name>[product_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>account_id</remote-name><local-name>[account_id (accounts)]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>account_manager</remote-name><local-name>[account_manager]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>product_id</remote-name><local-name>[product_id (products)]</local-name><parent-name>[products]</parent-name><local-type>string</local-type></metadata-record>
      <metadata-record class='column'><remote-name>paper_type</remote-name><local-name>[paper_type]</local-name><parent-name>[products]</parent-name><local-type>string</local-type></metadata-record>
        </metadata-records>
      </connection>
    <column datatype="string" name="[order_id]" role="dimension" type="nominal" />
    <column datatype="integer" name="[quantity]" role="measure" type="quantitative" />
    <column datatype="real" name="[post_discount_revenue]" role="measure" type="quantitative" />
    <column datatype="string" name="[account_id]" role="dimension" type="nominal" />
    <column datatype="string" name="[product_id]" role="dimension" type="nominal" />
    <column datatype="string" name="[account_id (accounts)]" role="dimension" type="nominal" />
    <column datatype="string" name="[account_manager]" role="dimension" type="nominal" />
    <column datatype="string" name="[product_id (products)]" role="dimension" type="nominal" />
    <column datatype="string" name="[paper_type]" role="dimension" type="nominal" />
    <column caption="Group" datatype="string" name="[Calculation_201]" role="dimension" type="nominal">
      <calculation class='tableau' formula="UPPER([paper_type])" />
    </column>
    <column caption="User" datatype="string" name="[Calculation_202]" role="dimension" type="nominal">
      <calculation class='tableau' formula="LOWER([account_manager])" />
    </column>
    <column caption="Order" datatype="real" name="[Calculation_203]" role="measure" type="quantitative">
      <calculation class='tableau' formula="{FIXED [Calculation_201] : SUM([post_discount_revenue])}" />
    </column>
    <column caption="Select" datatype="real" name="[Calculation_204]" role="measure" type="quantitative">
      <calculation class='tableau' formula="SUM([post_discount_revenue]) / SUM([quantity])" />
    </column>
    <column caption="Where" datatype="real" name="[Calculation_205]" role="measure" type="quantitative">
      <calculation class='tableau' formula="RUNNING_SUM(SUM([post_discount_revenue]))" />
    </column>
    </datasource>
    <datasource caption='Reserved Accounts' inline='true' name='federated.reserved0accounts' version='18.1'>
      <connection class='federated'>
        <named-connections><named-connection caption='warehouse' name='postgres.reserved0a'><connection class='postgres' dbname='dunder_mifflin' server='warehouse.example.com' /></named-connection></named-connections>
        <relation connection='postgres.reserved0a' name='accounts' table='[public].[accounts]' type='table' />
        <metadata-records>
          <metadata-record class='column'><remote-name>account_id</remote-name><local-name>[account_id]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>account_manager</remote-name><local-name>[account_manager]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type></metadata-record>
        </metadata-records>
      </connection>
      <column caption="User" datatype="string" name="[Calculation_301]" role="dimension" type="nominal"><calculation class='tableau' formula="LOWER([account_manager])" /></column>
      <column caption="Limit" datatype="integer" name="[Calculation_302]" role="measure" type="quantitative"><calculation class='tableau' formula="COUNTD([account_id])" /></column>
    </datasource>
    <datasource caption='Reserved Relationships' inline='true' name='federated.reserved0rel' version='18.1'>
      <connection class='federated'>
        <named-connections><named-connection caption='warehouse' name='postgres.reserved0r'><connection class='postgres' dbname='dunder_mifflin' server='warehouse.example.com' /></named-connection></named-connections>
        <relation type='collection'>
          <relation connection='postgres.reserved0r' name='orders' table='[public].[orders]' type='table' />
          <relation connection='postgres.reserved0r' name='accounts' table='[public].[accounts]' type='table' />
        </relation>
        <cols>
          <map key='[account_id]' value='[orders].[account_id]' />
          <map key='[quantity]' value='[orders].[quantity]' />
          <map key='[account_id (accounts)]' value='[accounts].[account_id]' />
          <map key='[account_manager]' value='[accounts].[account_manager]' />
        </cols>
        <metadata-records>
          <metadata-record class='column'><remote-name>account_id</remote-name><local-name>[account_id]</local-name><parent-name>[orders]</parent-name><local-type>string</local-type><object-id>[orders_0A1B2C3D4E5F40718293A4B5C6D7E8F9]</object-id></metadata-record>
          <metadata-record class='column'><remote-name>quantity</remote-name><local-name>[quantity]</local-name><parent-name>[orders]</parent-name><local-type>integer</local-type><object-id>[orders_0A1B2C3D4E5F40718293A4B5C6D7E8F9]</object-id></metadata-record>
          <metadata-record class='column'><remote-name>account_id</remote-name><local-name>[account_id (accounts)]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type><object-id>[accounts_1B2C3D4E5F60718293A4B5C6D7E8F90A]</object-id></metadata-record>
          <metadata-record class='column'><remote-name>account_manager</remote-name><local-name>[account_manager]</local-name><parent-name>[accounts]</parent-name><local-type>string</local-type><object-id>[accounts_1B2C3D4E5F60718293A4B5C6D7E8F90A]</object-id></metadata-record>
        </metadata-records>
      </connection>
      <column datatype='string' name='[account_id]' role='dimension' type='nominal' />
      <column datatype='integer' name='[quantity]' role='measure' type='quantitative' />
      <column datatype='string' name='[account_id (accounts)]' role='dimension' type='nominal' />
      <column datatype='string' name='[account_manager]' role='dimension' type='nominal' />
      <column caption="User" datatype="string" name="[Calculation_401]" role="dimension" type="nominal"><calculation class='tableau' formula="LOWER([account_manager])" /></column>
      <object-graph>
        <objects>
          <object caption='orders' id='orders_0A1B2C3D4E5F40718293A4B5C6D7E8F9'><properties context=''><relation connection='postgres.reserved0r' name='orders' table='[public].[orders]' type='table' /></properties></object>
          <object caption='accounts' id='accounts_1B2C3D4E5F60718293A4B5C6D7E8F90A'><properties context=''><relation connection='postgres.reserved0r' name='accounts' table='[public].[accounts]' type='table' /></properties></object>
        </objects>
        <relationships>
          <relationship><expression op='='><expression op='[account_id]' /><expression op='[account_id (accounts)]' /></expression><first-end-point object-id='orders_0A1B2C3D4E5F40718293A4B5C6D7E8F9' /><second-end-point object-id='accounts_1B2C3D4E5F60718293A4B5C6D7E8F90A' /></relationship>
        </relationships>
      </object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Revenue by Group">
      <table>
        <view><datasources><datasource caption='Reserved Words' name='federated.reserved0demo' /></datasources></view>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.reserved0demo].[none:Calculation_201:nk]</rows>
        <cols>[federated.reserved0demo].[sum:post_discount_revenue:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Quantity by User and Group">
      <table>
        <view><datasources><datasource caption='Reserved Words' name='federated.reserved0demo' /></datasources></view>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.reserved0demo].[none:Calculation_202:nk] / [federated.reserved0demo].[none:Calculation_201:nk]</rows>
        <cols>[federated.reserved0demo].[sum:quantity:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Order by User">
      <table>
        <view><datasources><datasource caption='Reserved Words' name='federated.reserved0demo' /></datasources></view>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.reserved0demo].[none:Calculation_202:nk]</rows>
        <cols>[federated.reserved0demo].[max:Calculation_203:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Price by Group">
      <table>
        <view><datasources><datasource caption='Reserved Words' name='federated.reserved0demo' /></datasources></view>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.reserved0demo].[none:Calculation_201:nk]</rows>
        <cols>[federated.reserved0demo].[usr:Calculation_204:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Running Revenue by Group">
      <table>
        <view><datasources><datasource name='federated.reserved0demo' /></datasources></view>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.reserved0demo].[none:Calculation_201:nk]</rows>
        <cols>[federated.reserved0demo].[usr:Calculation_205:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Running Revenue by User and Group">
      <table>
        <view><datasources><datasource name='federated.reserved0demo' /></datasources></view>
        <panes><pane><mark class="Text" /><encodings><text column="[federated.reserved0demo].[usr:Calculation_205:qk]" /></encodings></pane></panes>
        <rows>[federated.reserved0demo].[none:Calculation_202:nk]</rows>
        <cols>[federated.reserved0demo].[none:Calculation_201:nk]</cols>
      </table>
    </worksheet>
    <worksheet name="Quantity and Limit by User">
      <table>
        <view><datasources><datasource name='federated.reserved0demo' /><datasource name='federated.reserved0accounts' /></datasources></view>
        <panes><pane><mark class="Text" /><encodings><text column="[federated.reserved0demo].[sum:quantity:qk]" /><text column="[federated.reserved0accounts].[usr:Calculation_302:qk]" /></encodings></pane></panes>
        <rows>[federated.reserved0demo].[none:Calculation_202:nk]</rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="Related Quantity by User">
      <table>
        <view><datasources><datasource name='federated.reserved0rel' /></datasources></view>
        <panes><pane><mark class="Bar" /></pane></panes>
        <rows>[federated.reserved0rel].[none:Calculation_401:nk]</rows>
        <cols>[federated.reserved0rel].[sum:quantity:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
</workbook>
